from __future__ import annotations

from typing import Optional, Union

from pydantic import BaseModel, Field
from pydantic.experimental.missing_sentinel import MISSING


class FieldStates(BaseModel):
    optional_plain: Union[str, MISSING] = MISSING
    optional_nullable: Union[Optional[str], MISSING] = MISSING
    optional_default: str = 'optional'
    optional_nullable_default: Optional[str] = 'optional-nullable'
    required_plain: str
    required_nullable: Optional[str] = Field(...)
    required_default: str = 'required'
    required_nullable_default: Optional[str] = 'required-nullable'
