{
  "default": {"package": true, "remove": ["models.py", "server/README.md", "server/services.py"], "check": "sibling"},
  "nested-output": {"notice": "dependencies-json-nested-output.txt", "model": "generated/models.py", "server": "generated/server", "package": true, "remove": ["generated/models.py", "generated/server/README.md", "generated/server/services.py"], "check": "nested-output"},
  "separate-parents": {"notice": "dependencies-json-separate-parents.txt", "model": "models/models.py", "server": "service/server", "package": true, "remove": ["models/models.py", "service/server/README.md", "service/server/services.py"], "check": "separate-parents"},
  "suffixless-model": {"model": "models", "package": true, "remove": ["models", "server/README.md", "server/services.py"], "check": "suffixless-model"},
  "empty-models": {"notice": "dependencies-empty-models.txt", "source": "empty.yaml", "remove": ["server/README.md", "server/services.py"], "check": "empty-models"},
  "modular": {"notice": "dependencies-modular.txt", "source": "modular.yaml", "model": "models", "payload": "modular", "remove": ["models", "server/README.md", "server/services.py"], "check": "modular"},
  "absolute": {"notice": "dependencies-modular.txt", "source": "modular.yaml", "model": "models", "absolute": ["model", "server"], "payload": "modular"},
  "mixed-paths": {"notice": "dependencies-modular.txt", "source": "modular.yaml", "model": "models", "absolute": ["server"], "payload": "modular"},
  "leftover-manifest": {
    "notice": "dependencies-modular.txt",
    "source": "modular.yaml",
    "model": "models",
    "write": {"server/.dcg-target-manifest.json": "{\"format\": 1}\n"},
    "payload": "modular"
  },
  "foreign": {"package": true, "write": {"server/routers/__init__.py": "# Someone else's module.\n"}},
  "warning": {"notice": "dependencies-json-warning.txt", "input": "callbacks.yaml", "warnings": "documentation-warning.txt"},
  "metadata-lock": {"notice": "dependencies-modular.txt", "source": "modular.yaml", "model": "models", "publish": ["--emit-model-metadata", "metadata.json", "--lockfile", "api.lock", "--update-lock"], "payload": "modular", "published": ["metadata.json", "api.lock"]},
  "latin-1": {"notice": "dependencies-json-carriage-return-header.txt", "source": "inline.yaml", "encoding": "latin-1", "templates": true, "options": ["--custom-file-header", "# -*- coding: latin-1 -*-\n# Café"], "payload": "latin-1"},
  "carriage-return-header": {"notice": "dependencies-json-carriage-return-header.txt", "source": "inline.yaml", "options": ["--custom-file-header", "# first\r# second"], "payload": "carriage-return-header"},
  "stale": {"notice": "dependencies-stale.txt", "repeat": true, "options": ["--openapi-include-paths", "/pets"], "stale": "stale", "warnings": "leftover-warning.txt"},
  "models-in-package": {
    "model": "server/models.py",
    "options": ["--server-model-package", "server.models"],
    "payload": "models-in-package",
    "remove": ["server/models.py", "server/README.md", "server/services.py"],
    "check": "models-in-package"
  },
  "package-in-models": {
    "notice": "dependencies-models-server.txt",
    "source": "modular.yaml",
    "model": "models",
    "server": "models/server",
    "options": ["--server-package", "models.server", "--server-model-package", "models"],
    "notice": "dependencies-models-server.txt",
    "unvalidated": true,
    "payload": "package-in-models",
    "unchanged": "unchanged-models-server.json",
    "remove": ["models/pets.py", "models/server/README.md", "models/server/services.py"],
    "check": "package-in-models"
  }
}
