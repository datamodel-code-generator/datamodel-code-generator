{
  "pets": {
    "input": "pets.yaml",
    "backends": [
      "pydantic_v2.BaseModel",
      "pydantic_v2.dataclass"
    ],
    "runtime": [
      "pydantic_v2.BaseModel"
    ],
    "package_snapshots": [
      "pydantic_v2.BaseModel"
    ]
  },
  "parameters": {
    "input": "parameters.yaml",
    "package_snapshots": []
  },
  "bodies": {
    "input": "bodies.yaml",
    "config": {
      "body_modes": [
        [
          "/paths/~1raw/post",
          "request"
        ]
      ]
    },
    "package_snapshots": []
  },
  "request": {
    "input": "bodies.yaml",
    "config": {
      "include_request": true,
      "body_mode": "request",
      "body_modes": [
        [
          "/paths/~1json/post",
          "typed"
        ]
      ],
      "selection": {
        "include_operations": [
          "/paths/~1json/post",
          "/paths/~1text/post"
        ],
        "reason": "Two request modes."
      }
    },
    "package_snapshots": []
  },
  "responses": {
    "input": "responses.yaml",
    "backends": [
      "pydantic_v2.BaseModel",
      "pydantic_v2.dataclass"
    ],
    "config": {
      "primary_responses": [
        [
          "/paths/~1created/post",
          {
            "status_code": 201,
            "media_type": "application/vnd.thing+json"
          }
        ]
      ]
    },
    "package_snapshots": []
  },
  "names": {
    "input": "names.yaml",
    "config": {
      "operation_names": [
        [
          "/paths/~1health/get",
          "health_check"
        ]
      ],
      "router_names": {
        "untagged": "misc"
      },
      "parameter_names": [
        [
          "/paths/~1files~1{file.name}~1{dcg_p0}/get",
          {
            "query:limit": "page_size"
          }
        ]
      ]
    },
    "package_snapshots": []
  },
  "single": {
    "input": "pets.yaml",
    "config": {
      "layout": "single"
    },
    "package_snapshots": []
  },
  "standalone": {
    "input": "pets.yaml",
    "config": {
      "package_mode": "standalone",
      "package_version": "1.0.0",
      "distribution_name": "pets-server",
      "model_dependency": "pets-models>=1.0"
    },
    "package_snapshots": []
  },
  "encoding": {
    "input": "server-parameters.yaml",
    "config": {
      "encoding": "latin-1",
      "package_mode": "standalone",
      "package_version": "1.0.0",
      "distribution_name": "menu-server",
      "model_dependency": "menu-models>=1.0"
    },
    "package_snapshots": []
  },
  "route-errors": {
    "input": "route-errors.yaml"
  },
  "name-errors": {
    "input": "name-errors.yaml"
  },
  "group-errors": {
    "input": "group-errors.yaml",
    "config": {
      "router_names": {
        "tag:four": "OPERATIONS"
      }
    }
  },
  "repeat-32": {
    "input": "repeat-32.yaml"
  },
  "media-errors": {
    "input": "media-errors.yaml"
  },
  "selector-errors": {
    "input": "pets.yaml",
    "config": {
      "operation_names": [
        [
          "/paths/~1missing/get",
          "missing"
        ],
        [
          "/paths/~1pets/get",
          "all_pets"
        ],
        [
          {
            "pointer": "/paths/~1pets/get"
          },
          "every_pet"
        ]
      ],
      "body_modes": [
        [
          "/paths/~1pets/delete",
          "request"
        ]
      ]
    }
  },
  "primary-errors": {
    "input": "responses.yaml",
    "config": {
      "primary_responses": [
        [
          "/paths/~1created/post",
          {
            "status_code": 201,
            "media_type": "application/xml"
          }
        ],
        [
          "/paths/~1download/get",
          {
            "status_code": 204
          }
        ],
        [
          "/paths/~1optional/get",
          {
            "status_code": 200,
            "media_type": "not a media type"
          }
        ]
      ]
    }
  },
  "backend-errors": {
    "input": "pets.yaml",
    "backends": [
      "dataclasses.dataclass",
      "typing.TypedDict",
      "msgspec.Struct"
    ]
  },
  "types": {
    "input": "types.yaml",
    "model": {
      "use_annotated": true,
      "field_constraints": true,
      "output_datetime_class": "datetime"
    },
    "package_snapshots": []
  },
  "unbound": {
    "input": "unbound.yaml",
    "model": {
      "openapi_scopes": [
        "schemas"
      ]
    }
  },
  "methods": {
    "input": "methods.yaml",
    "package_snapshots": []
  },
  "codec-errors": {
    "input": "codec-errors.yaml"
  },
  "native": {
    "input": "native.yaml",
    "backends": [
      "pydantic_v2.BaseModel",
      "pydantic_v2.dataclass"
    ],
    "package_snapshots": []
  },
  "native-settings": {
    "input": "native-settings.yaml",
    "model": {
      "allow_population_by_field_name": true,
      "aliases": {
        "title": [
          "title",
          "heading"
        ]
      },
      "use_missing_sentinel": true,
      "field_include_all_keys": true
    },
    "package_snapshots": []
  },
  "native-readonly": {
    "input": "bodies.yaml",
    "model": {
      "read_only_write_only_model_type": "request-response"
    },
    "config": {
      "selection": {
        "include_operations": [
          "/paths/~1json~1envelope/post"
        ],
        "reason": "Split models."
      }
    },
    "package_snapshots": []
  },
  "native-custom": {
    "input": "custom-models.yaml",
    "model": {
      "base_class": "app.bases.Base"
    },
    "package_snapshots": []
  },
  "native-generator": {
    "input": "custom-models.yaml",
    "model": {
      "alias_generator": "to_camel"
    },
    "package_snapshots": []
  },
  "unbound-body": {
    "input": "unbound-body.yaml",
    "model": {
      "openapi_scopes": [
        "schemas"
      ],
      "collapse_root_models": true
    }
  },
  "argument-errors": {
    "input": "argument-errors.yaml",
    "config": {
      "include_request": true,
      "parameter_names": [
        [
          "/paths/~1items/get",
          {
            "query:req": "request",
            "query:page": "limit",
            "header:size": "limit"
          }
        ]
      ]
    }
  },
  "security": {
    "input": "server-security.yaml",
    "config": {
      "handler_modes": [
        [
          "/paths/~1maybe/get",
          "async"
        ],
        [
          "/paths/~1custom/get",
          "async"
        ]
      ]
    },
    "package_snapshots": []
  },
  "security-errors": {
    "input": "security-errors.yaml"
  },
  "info": {
    "input": "info.yaml",
    "config": {
      "layout": "single"
    },
    "package_snapshots": []
  },
  "callbacks": {
    "input": "callbacks.yaml",
    "config": {
      "hooks": [
        "record"
      ]
    },
    "package_snapshots": []
  },
  "scheme-names": {
    "input": "scheme-names.yaml"
  },
  "services": {
    "input": "services.yaml",
    "config": {
      "handler_modes": [
        [
          "/paths/~1health/get",
          "async"
        ]
      ]
    },
    "package_snapshots": []
  },
  "empty": {
    "input": "services.yaml",
    "config": {
      "selection": {
        "exclude_operations": [
          "/paths/~1pets/get",
          "/paths/~1pets~1{petId}/delete",
          "/paths/~1pets~1{petId}~1moves/post",
          "/paths/~1health/get"
        ],
        "reason": "No operations yet."
      }
    },
    "package_snapshots": []
  },
  "hooks": {
    "input": "hooks.yaml",
    "config": {
      "include_request": true,
      "body_modes": [
        [
          "/paths/~1raw/post",
          "request"
        ]
      ],
      "hooks": [
        "rename",
        "reverse",
        "asynchronous",
        "annotate",
        "record"
      ]
    },
    "files": [
      "hooks-paths.yaml"
    ],
    "package_snapshots": []
  },
  "hook-file": {
    "input": "hooks.yaml",
    "backends": [
      "pydantic_v2.BaseModel",
      "pydantic_v2.dataclass"
    ],
    "config": {
      "include_request": true,
      "body_modes": [
        [
          "/paths/~1raw/post",
          "request"
        ]
      ],
      "hooks": [
        {
          "file": "hooks/tagged.py"
        },
        {
          "module": "tests.data.python.fastapi_hooks",
          "callable": "rename"
        },
        {
          "file": "hooks/tagged.py"
        },
        {
          "file": "hooks/tagged.py",
          "callable": "annotate"
        }
      ]
    },
    "files": [
      "hooks-paths.yaml"
    ],
    "package_snapshots": []
  },
