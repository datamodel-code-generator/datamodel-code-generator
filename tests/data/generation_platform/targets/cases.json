  "provenance": {
    "input": {"path": "api.yaml"},
    "target": "client",
    "model": {
      "openapi_scopes": ["api"],
      "custom_file_header_path": "spec/header.txt",
      "http_headers": [["Authorization", "Bearer secret"]],
      "http_timeout": 5.0,
      "custom_class_name_generator": true,
      "lockfile": "locks/remote.lock",
      "update_lock": true
    },
    "config": {
      "formatter_settings": "pyproject.toml",
      "custom_formatters": ["tests.data.python.custom_formatters.add_comment"],
      "custom_formatter_kwargs": {"width": 100},
      "hook": true,
      "token": true,
      "labels": ["b", "a"],
      "primary": {"pointer": "/paths/~1pets/get", "document": "spec/api.yaml"},
      "export_bindings": [
        {"schema": {"pointer": "/components/schemas/Pet"}, "module": "example.models", "symbol": "FixturePet"}
      ],
      "builtin_codec_compatibility": [
        {
          "name": "orders",
          "backend": "pydantic_v2.BaseModel",
          "schemas": [{"pointer": "/Order", "document": "spec/common.yaml"}]
        }
      ]
    },
    "steps": [
      {"render": {}},
      {"manifest": null}
    ]
  },
