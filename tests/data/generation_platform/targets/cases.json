        "include_operations": [{"pointer": "/paths/~1items/get", "document": "urn:dcg:root"}],
        "reason": "Items only"
      }}}},
      {"render": {"input": {"list": ["inline.yaml"]}}},
      {"render": {"input": {"directory": "."}}},
      {"render": {"model": {"input_file_type": "jsonschema"}}}
