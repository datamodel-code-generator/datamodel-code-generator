  "selection": {
    "input": {"path": "api.yaml"},
    "model": {"openapi_scopes": ["api"]},
    "steps": [
      {
        "render": {
          "config": {
            "selection": {
              "include_tags": ["pets"],
              "exclude_operations": ["/paths/~1pets/post"],
              "reason": "Only reading pets"
            }
          }
        }
      },
      {"manifest": null},
      {"render": {"config": {"selection": {"exclude_tags": ["admin"], "reason": "Administration runs elsewhere"}}}},
      {
        "render": {
          "config": {
            "selection": {
              "include_operations": [
                "/paths/~1nope/get",
                "/webhooks/petAdded/post",
                {"pointer": "/paths/~1pets/get", "document": "spec/other.yaml"},
                "/paths/~1pets/get",
                {"pointer": "/paths/~1pets/get", "document": "spec/api.yaml"}
              ],
              "include_tags": ["missing"],
              "exclude_tags": ["absent"],
              "reason": "Broken selection"
            }
          }
        }
      },
      {"render": {"config": {"selection": {"include_operations": ["/paths/~1pets/get"], "reason": "One operation"}}}},
      {"remember": "shorthand"},
      {
        "render": {
          "config": {
            "selection": {
              "include_operations": [{"pointer": "/paths/~1pets/get", "document": "spec/api.yaml"}],
              "reason": "One operation"
            }
          }
        }
      },
      {"compare": "shorthand"},
      {
        "render": {
          "config": {
            "selection": {
              "include_operations": [{"pointer": "/paths/~1pets/get", "document": "{root}/spec/api.yaml"}],
              "reason": "One operation"
            }
          }
        }
      },
      {"compare": "shorthand"}
    ]
  },
  "inputs": {
    "input": {"text": "inline.yaml"},
    "model": {"openapi_scopes": ["api"]},
    "steps": [
      {
        "render": {
          "config": {
            "selection": {
              "include_operations": [{"pointer": "/paths/~1items/get", "document": "urn:dcg:root"}],
              "reason": "Items only"
            }
          }
        }
      },
      {"manifest": null},
      {"render": {"input": {"mapping": "inline.yaml"}, "model": {"input_file_type": "openapi"}}},
      {
        "render": {
          "input": {"path": "inline.yaml"},
          "config": {
            "selection": {
              "include_operations": [{"pointer": "/paths/~1items/get", "document": "urn:dcg:root"}],
              "reason": "Items only"
            }
          }
        }
      },
      {"render": {"input": {"list": ["inline.yaml"]}}},
      {"render": {"input": {"directory": "."}}},
      {"render": {"model": {"input_file_type": "jsonschema"}}}
    ]
  },
