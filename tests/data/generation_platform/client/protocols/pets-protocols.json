{
  "pages.all": {
    "kind": "pagination",
    "operation": "/paths/~1pets~1pages/get",
    "items": {"from": "body", "pointer": "/data"},
    "item_schema": {"pointer": "/components/schemas/Pet"},
    "continuation": {
      "kind": "cursor",
      "read": {"from": "body", "pointer": "/next_cursor"},
      "write": {"in": "query", "name": "cursor"},
      "end": [{"kind": "missing"}, {"kind": "null"}],
      "empty_string": "end"
    }
  },
  "jobs.run": {
    "kind": "polling",
    "create": "/paths/~1jobs/post",
    "accepted_statuses": [202],
    "poll": "/paths/~1jobs~1{jobId}/get",
    "bindings": [
      {
        "target": {"in": "path", "name": "jobId"},
        "value": {"source": "initial", "selector": {"from": "body", "pointer": "/id"}}
      }
    ],
    "state": {"from": "body", "pointer": "/status"},
    "pending": ["running"],
    "succeeded": ["done"],
    "result": {
      "kind": "inline",
      "selector": {"from": "body", "pointer": "/result"},
      "schema": {"pointer": "/components/schemas/Pet"}
    },
    "interval": {"seconds": 1}
  },
  "events.watch": {
    "kind": "sse",
    "operation": "/paths/~1pets~1events/get",
    "media": "text/event-stream",
    "event_schema": {"pointer": "/components/schemas/Pet"},
    "completion": {"kind": "eof"}
  },
  "sockets.pets": {
    "kind": "websocket",
    "operation": "/paths/~1pets~1socket/get",
    "send": {"codec": "json", "schema": {"pointer": "/components/schemas/NewPet"}},
    "receive": {"codec": "json", "schema": {"pointer": "/components/schemas/Pet"}}
  },
  "jobs.cached": {
    "kind": "cache",
    "operation": "/paths/~1jobs~1{jobId}/get",
    "validator": "etag",
    "authenticated": false
  },
  "files.upload": {
    "kind": "resumable_upload",
    "profile": "offset",
    "create": {"operation": "/paths/~1files/post", "size": {"in": "header", "name": "Upload-Length"}},
    "probe": {
      "operation": "/paths/~1files~1{fileId}/head",
      "bindings": [
        {
          "target": {"in": "path", "name": "fileId"},
          "value": {"source": "initial", "selector": {"from": "body", "pointer": "/id"}}
        }
      ],
      "remote_offset": {"from": "header", "name": "Upload-Offset"}
    },
    "append": {
      "operation": "/paths/~1files~1{fileId}/patch",
      "bindings": [
        {
          "target": {"in": "path", "name": "fileId"},
          "value": {"source": "initial", "selector": {"from": "body", "pointer": "/id"}}
        }
      ],
      "offset": {"in": "header", "name": "Upload-Offset"}
    },
    "max_chunk_bytes": 4,
    "partial_commit": "allowed",
    "completion": {"kind": "length"}
  },
  "hooks.created": {
    "kind": "webhook",
    "event_schema": {"pointer": "/components/schemas/Pet"},
    "signature": {"kind": "standard_webhooks"}
  }
}
