{
  "records.all": {
    "kind": "ndjson",
    "operation": "/paths/~1records/get",
    "media": "application/x-ndjson",
    "event_schema": {"pointer": "/components/schemas/Record"},
    "completion": {"kind": "eof"},
    "final_line": "require_newline"
  },
  "records.lenient": {
    "kind": "ndjson",
    "operation": "/paths/~1records/get",
    "media": "application/x-ndjson",
    "event_schema": {"pointer": "/components/schemas/Record"},
    "completion": {"kind": "eof"},
    "final_line": "allow_eof"
  },
  "records.tagged": {
    "kind": "ndjson",
    "operation": "/paths/~1records/get",
    "media": "application/x-ndjson",
    "event_schema": {
      "discriminator": {"from": "body", "pointer": "/type"},
      "mapping": {
        "created": {"pointer": "/components/schemas/Created"},
        "deleted": {"pointer": "/components/schemas/Deleted"}
      }
    },
    "unknown": "raw",
    "error_events": {"failed": {"pointer": "/components/schemas/Failure"}},
    "completion": {"kind": "sentinel", "value": "[DONE]"},
    "final_line": "require_newline"
  },
  "search.all": {
    "kind": "ndjson",
    "operation": "/paths/~1search/post",
    "media": "Application/JSONL",
    "event_schema": {"pointer": "/components/schemas/Record"},
    "completion": {"kind": "sentinel", "value": "[DONE]"},
    "final_line": "allow_eof"
  }
}
