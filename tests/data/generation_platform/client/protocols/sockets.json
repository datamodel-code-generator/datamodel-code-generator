{
  "rooms.chat": {
    "kind": "websocket",
    "operation": "/paths/~1rooms~1{room}~1socket/get",
    "subprotocols": ["chat.v2", "chat.v1"],
    "send": {"codec": "json", "schema": {"pointer": "/components/schemas/ClientMessage"}},
    "receive": {"codec": "json", "schema": {"pointer": "/components/schemas/ServerMessage"}}
  },
  "feed.text": {
    "kind": "websocket",
    "operation": "/paths/~1feed~1socket/get",
    "send": {"codec": "utf8"},
    "receive": {"codec": "bytes"}
  },
  "secure.chat": {
    "kind": "websocket",
    "operation": "/paths/~1secure~1socket/get",
    "send": {"codec": "bytes"},
    "receive": {"codec": "utf8"}
  }
}
