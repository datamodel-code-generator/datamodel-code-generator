{
  "searches.ticks": {
    "kind": "sse",
    "operation": "/paths/~1search-feed/post",
    "media": "text/event-stream",
    "event_schema": {"pointer": "/components/schemas/Tick"},
    "completion": {"kind": "eof"},
    "resume": {
      "enabled": true,
      "cursor": {"from": "body", "pointer": "/seq"},
      "missing": "error",
      "null": "error",
      "write": {"in": "body", "pointer": "/after"},
      "reopen_operation": "/paths/~1search-feed/post",
      "delivery": "at_least_once"
    }
  },
  "feed.live": {
    "kind": "sse",
    "operation": "/paths/~1feed/post",
    "media": "text/event-stream",
    "event_schema": {"pointer": "/components/schemas/Tick"},
    "completion": {"kind": "eof"},
    "resume": {
      "enabled": true,
      "cursor": "event_id",
      "write": {"in": "header", "name": "Last-Event-ID"},
      "reopen_operation": "/paths/~1feed/post",
      "delivery": "at_least_once"
    }
  },
  "events.live": {
    "kind": "sse",
    "operation": "/paths/~1events/get",
    "media": "text/event-stream",
    "event_schema": {"pointer": "/components/schemas/Message"},
    "completion": {"kind": "eof"},
    "resume": {
      "enabled": true,
      "cursor": "event_id",
      "write": {"in": "header", "name": "Last-Event-ID"},
      "reopen_operation": "/paths/~1events/get",
      "delivery": "at_least_once"
    }
  },
  "events.plain": {
    "kind": "sse",
    "operation": "/paths/~1events/get",
    "media": "text/event-stream",
    "event_schema": {"pointer": "/components/schemas/Message"},
    "completion": {"kind": "eof"}
  },
  "events.tracked": {
    "kind": "sse",
    "operation": "/paths/~1events/get",
    "media": "text/event-stream",
    "event_schema": {
      "discriminator": {"from": "event_type"},
      "mapping": {"created": {"pointer": "/components/schemas/Created"}}
    },
    "unknown": "raw",
    "error_events": {"error": {"pointer": "/components/schemas/StreamError"}},
    "completion": {"kind": "event_type", "value": "done"},
    "resume": {
      "enabled": true,
      "cursor": "event_id",
      "write": {"in": "header", "name": "Last-Event-ID"},
      "reopen_operation": "/paths/~1streams~1{streamId}/get",
      "delivery": "at_least_once",
      "bindings": [
        {
          "target": {"in": "path", "name": "streamId"},
          "value": {"source": "initial", "selector": {"from": "header", "name": "X-Stream-Id"}}
        },
        {
          "target": {"in": "query", "name": "token"},
          "value": {"source": "previous", "selector": {"from": "header", "name": "X-Resume-Token"}}
        },
        {"target": {"in": "query", "name": "mode"}, "value": {"literal": "resume"}}
      ],
      "reconnect_on": ["transport_interruption", "incomplete_eof"],
      "expires_at": {"from": "header", "name": "X-Stream-Expires"}
    }
  },
  "rooms.live": {
    "kind": "sse",
    "operation": "/paths/~1rooms~1{room}{shard}/get",
    "media": "text/event-stream",
    "event_schema": {"pointer": "/components/schemas/Message"},
    "completion": {"kind": "eof"},
    "resume": {
      "enabled": true,
      "cursor": "event_id",
      "write": {"in": "header", "name": "Last-Event-ID"},
      "reopen_operation": "/paths/~1rooms~1{room}{shard}/get",
      "delivery": "at_least_once",
      "bindings": [
        {
          "target": {"in": "path", "name": "shard"},
          "value": {"source": "previous", "selector": {"from": "header", "name": "X-Shard"}}
        }
      ]
    }
  },
  "records.all": {
    "kind": "ndjson",
    "operation": "/paths/~1records/get",
    "media": "application/x-ndjson",
    "event_schema": {"pointer": "/components/schemas/Record"},
    "completion": {"kind": "eof"},
    "final_line": "require_newline",
    "resume": {
      "enabled": true,
      "cursor": {"from": "body", "pointer": "/id"},
      "missing": "inherit",
      "null": "clear",
      "write": {"in": "query", "name": "after"},
      "reopen_operation": "/paths/~1records/get",
      "delivery": "at_least_once"
    }
  },
  "feed.ticks": {
    "kind": "sse",
    "operation": "/paths/~1feed/post",
    "media": "text/event-stream",
    "event_schema": {
      "discriminator": {"from": "event_type"},
      "mapping": {"tick": {"pointer": "/components/schemas/Tick"}}
    },
    "unknown": "raw",
    "completion": {"kind": "sentinel", "value": "[DONE]"},
    "resume": {
      "enabled": true,
      "cursor": {"from": "body", "pointer": "/seq"},
      "missing": "error",
      "null": "error",
      "write": {"in": "body", "pointer": "/after"},
      "reopen_operation": "/paths/~1feed/post",
      "delivery": "at_least_once",
      "reconnect_on": ["incomplete_eof"]
    }
  },
  "topics.marks": {
    "kind": "sse",
    "operation": "/paths/~1events/get",
    "media": "text/event-stream",
    "event_schema": {
      "discriminator": {"from": "event_type"},
      "mapping": {"created": {"pointer": "/components/schemas/Created"}}
    },
    "unknown": "raw",
    "completion": {"kind": "eof"},
    "resume": {
      "enabled": true,
      "cursor": {"from": "body", "pointer": "/id"},
      "missing": "inherit",
      "null": "clear",
      "write": {"in": "query", "name": "topic"},
      "reopen_operation": "/paths/~1events/get",
      "delivery": "at_least_once"
    }
  },
  "marks.scoped": {
    "kind": "sse",
    "operation": "/paths/~1marks/get",
    "media": "text/event-stream",
    "event_schema": {"pointer": "/components/schemas/Mark"},
    "completion": {"kind": "eof"},
    "resume": {
      "enabled": true,
      "cursor": {"from": "body", "pointer": "/scope"},
      "missing": "inherit",
      "null": "clear",
      "write": {"in": "query", "name": "scope"},
      "reopen_operation": "/paths/~1marks/get",
      "delivery": "at_least_once"
    }
  },
  "marks.named": {
    "kind": "sse",
    "operation": "/paths/~1named-marks/get",
    "media": "text/event-stream",
    "event_schema": {"pointer": "/components/schemas/Mark"},
    "completion": {"kind": "eof"},
    "resume": {
      "enabled": true,
      "cursor": {"from": "body", "pointer": "/scope"},
      "missing": "inherit",
      "null": "clear",
      "write": {"in": "query", "name": "scope"},
      "reopen_operation": "/paths/~1named-marks/get",
      "delivery": "at_least_once"
    }
  },
  "marks.deep": {
    "kind": "sse",
    "operation": "/paths/~1deep-marks/get",
    "media": "text/event-stream",
    "event_schema": {"pointer": "/components/schemas/Mark"},
    "completion": {"kind": "eof"},
    "resume": {
      "enabled": true,
      "cursor": {"from": "body", "pointer": "/scope"},
      "missing": "inherit",
      "null": "clear",
      "write": {"in": "query", "name": "scope"},
      "reopen_operation": "/paths/~1deep-marks/get",
      "delivery": "at_least_once"
    }
  },
  "marks.bound": {
    "kind": "sse",
    "operation": "/paths/~1marks/get",
    "media": "text/event-stream",
    "event_schema": {"pointer": "/components/schemas/Mark"},
    "completion": {"kind": "eof"},
    "resume": {
      "enabled": true,
      "cursor": "event_id",
      "write": {"in": "header", "name": "Last-Event-ID"},
      "reopen_operation": "/paths/~1marks/get",
      "delivery": "at_least_once",
      "bindings": [{"target": {"in": "query", "name": "scope"}, "value": {"literal": {"api_key": "SERVER_KEY"}}}]
    }
  },
  "marks.deepbound": {
    "kind": "sse",
    "operation": "/paths/~1deep-marks/get",
    "media": "text/event-stream",
    "event_schema": {"pointer": "/components/schemas/Mark"},
    "completion": {"kind": "eof"},
    "resume": {
      "enabled": true,
      "cursor": "event_id",
      "write": {"in": "header", "name": "Last-Event-ID"},
      "reopen_operation": "/paths/~1deep-marks/get",
      "delivery": "at_least_once",
      "bindings": [{"target": {"in": "query", "name": "scope"}, "value": {"literal": {"api_key": "SERVER_KEY"}}}]
    }
  }
}
