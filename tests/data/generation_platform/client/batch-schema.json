  "components": {
    "schemas": {
      "Item": {
        "type": "object",
        "required": [
          "id",
          "wire-label"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "wire-label": {
            "type": "string",
            "minLength": 1
          },
          "tier": {
            "type": "string",
            "default": "basic"
          },
          "secret": {
            "type": "string",
            "writeOnly": true
          },
          "server-note": {
            "type": "string",
            "readOnly": true
          }
        }
      },
      "Success": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string"
          }
        }
      },
      "ItemError": {
        "type": "object",
        "required": [
          "code"
        ],
        "properties": {
          "code": {
            "type": "string"
          }
        }
      },
      "Result": {
        "type": "object",
        "properties": {
          "value": {
            "$ref": "#/components/schemas/Success"
          },
          "error": {
            "$ref": "#/components/schemas/ItemError"
          }
        }
      },
      "Response": {
        "type": "object",
        "required": [
          "results"
        ],
        "properties": {
          "results": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Result"
            }
          }
        }
      }
    }
  }
