        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/Item"
                },
                "contains": {
                  "type": "object",
                  "required": [
                    "wire-label"
                  ],
                  "properties": {
