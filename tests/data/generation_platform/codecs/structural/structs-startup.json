{
  "backend": "msgspec.Struct",
  "package": "codec_structs_startup",
  "scopes": ["schemas", "paths"],
  "options": {"use_annotated": true, "field_constraints": true, "use_standard_primitive_types": true, "output_datetime_class": "datetime"},
  "startup": [
    {"name": "matching", "use": "/paths/~1limits/post request_body"},
    {"name": "not-struct", "use": "/paths/~1limits/post request_body",
     "models": {"models:Limits": "tests.data.python.model_codec_stdlib:InitTicket"}},
    {"name": "renamed", "use": "/paths/~1limits/post request_body",
     "models": {"models:Limits": "tests.data.python.model_codec_stdlib:NamedLimits"}},
    {"name": "required-disagrees", "use": "/paths/~1limits/post request_body",
     "models": {"models:Limits": "tests.data.python.model_codec_stdlib:RequiredLimits"}},
    {"name": "tag-disagrees", "use": "/paths/~1small/post request_body",
     "models": {"models:Small": "tests.data.python.model_codec_stdlib:TinySmall"}},
    {"name": "convert-refused", "use": "/paths/~1holders/post request_body", "binding": {"converter_strategy": "msgspec_convert"}},
    {"name": "structural-tz", "use": "/paths/~1stamps/post request_body", "binding": {"converter_strategy": "msgspec_structural"},
     "models": {"models:Stamped": "tests.data.python.model_codec_stdlib:LocalStamped"}, "decode": {"when": "2020-01-02T03:04:05Z"}},
    {"name": "unreadable-pattern", "use": "/paths/~1stamps/post request_body",
     "models": {"models:Stamped": "tests.data.python.model_codec_stdlib:LookaheadStamped"}},
    {"name": "constrained-tuple", "use": "/paths/~1stamps/post request_body",
     "models": {"models:Stamped": "tests.data.python.model_codec_stdlib:SizedStamped"}},
    {"name": "native-gap", "use": "/paths/~1limits/post request_body", "binding": {"projection_mode": "native"}, "decode": {"low": 2}},
    {"name": "native-gap-convert", "use": "/paths/~1limits/post request_body", "binding": {"projection_mode": "native"},
     "convert": {"low": 2}},
    {"name": "relaxed-tag", "use": "/paths/~1holders/post request_body", "decode": {"pet": {"size": "tiny"}},
     "patch": {"uri": "https://dcg.invalid/inputs/root", "pointer": "/components/schemas/Small/properties/size", "keyword": "const", "value": "tiny"}},
    {"name": "relaxed-pattern", "use": "/paths/~1coded/post request_body", "decode": {"code": "ABC"},
     "patch": {"uri": "https://dcg.invalid/inputs/root", "pointer": "/components/schemas/Coded/properties/code", "keyword": "pattern", "value": "^.*$"}},
    {"name": "relaxed-ge", "use": "/paths/~1coded/post request_body", "decode": {"code": "a", "low": 0},
     "patch": {"uri": "https://dcg.invalid/inputs/root", "pointer": "/components/schemas/Coded/properties/low", "keyword": "minimum", "value": -100}},
    {"name": "relaxed-lt", "use": "/paths/~1coded/post request_body", "decode": {"code": "a", "high": 50},
     "patch": {"uri": "https://dcg.invalid/inputs/root", "pointer": "/components/schemas/Coded/properties/high", "keyword": "exclusiveMaximum", "value": 100}},
    {"name": "relaxed-gt", "use": "/paths/~1coded/post request_body", "decode": {"code": "a", "ratio": -1},
     "patch": {"uri": "https://dcg.invalid/inputs/root", "pointer": "/components/schemas/Coded/properties/ratio", "keyword": "exclusiveMinimum", "value": -100}},
    {"name": "relaxed-le", "use": "/paths/~1coded/post request_body", "decode": {"code": "a", "ratio": 6},
     "patch": {"uri": "https://dcg.invalid/inputs/root", "pointer": "/components/schemas/Coded/properties/ratio", "keyword": "maximum", "value": 100}},
    {"name": "relaxed-multiple", "use": "/paths/~1coded/post request_body", "decode": {"code": "a", "ratio": 0.25},
     "patch": {"uri": "https://dcg.invalid/inputs/root", "pointer": "/components/schemas/Coded/properties/ratio", "keyword": "multipleOf", "value": 0.25}},
    {"name": "relaxed-min-length", "use": "/paths/~1coded/post request_body", "decode": {"code": "a", "name": "a"},
     "patch": {"uri": "https://dcg.invalid/inputs/root", "pointer": "/components/schemas/Coded/properties/name", "keyword": "minLength", "value": 0}},
    {"name": "relaxed-max-length", "use": "/paths/~1coded/post request_body", "decode": {"code": "a", "name": "abcdef"},
     "patch": {"uri": "https://dcg.invalid/inputs/root", "pointer": "/components/schemas/Coded/properties/name", "keyword": "maxLength", "value": 10}}
  ]
}
