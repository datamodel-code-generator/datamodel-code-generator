{
  "backend": "msgspec.Struct",
  "package": "codec_structs_options",
  "scopes": ["schemas", "paths", "api"],
  "strategies": true,
  "options": {"use_standard_primitive_types": true,
              "extra_template_data": {"Batch": {"base_class_kwargs": {"array_like": true}},
                                      "Limits": {"base_class_kwargs": {"forbid_unknown_fields": true}},
                                      "Holder": {"base_class_kwargs": {"forbid_unknown_fields": true, "omit_defaults": true}},
                                      "Entry": {"base_class_kwargs": {"tag": true}},
                                      "Stamped": {"base_class_kwargs": {"tag": "probe"}},
                                      "Worded": {"base_class_kwargs": {"tag_field": "kind"}},
                                      "Rated": {"base_class_kwargs": {"tag": false, "tag_field": "kind"}}}},
  "cases": [
    {"name": "limits-server-decode-unknown", "use": "/paths/~1limits/post request_body", "op": "decode", "value": {"low": 2, "zz": 1}},
    {"name": "limits-client-decode-unknown", "use": "/paths/~1limits/post response_body 200", "surface": "client", "op": "decode",
     "value": {"id": 1, "zz": 1}},
    {"name": "holder-server-decode-unknown", "use": "/paths/~1holders/post request_body", "op": "decode", "value": {"count": 0, "zz": 1}},
    {"name": "batch-server-decode", "use": "/paths/~1batches/post request_body", "op": "decode",
     "value": {"entries": [{"amount": "1.5"}], "a.b": "3"}},
    {"name": "batch-client-encode", "use": "/paths/~1batches/post request_body", "surface": "client", "op": "encode",
     "value": {"result": "batch-server-decode", "attr": "value"}},
    {"name": "stamps-server-decode", "use": "/paths/~1stamps/post request_body", "op": "decode", "value": {"when": "2020-01-02T03:04:05Z"}},
    {"name": "stamps-server-decode-tagged", "use": "/paths/~1stamps/post request_body", "op": "decode",
     "value": {"type": "probe", "when": "2020-01-02T03:04:05Z"}},
    {"name": "stamps-server-decode-other-tag", "use": "/paths/~1stamps/post request_body", "op": "decode", "value": {"type": "other"}},
    {"name": "stamps-client-encode", "use": "/paths/~1stamps/post request_body", "surface": "client", "op": "encode",
     "value": {"result": "stamps-server-decode", "attr": "value"}},
    {"name": "worded-server-decode", "use": "/paths/~1worded/post request_body", "op": "decode", "value": {"kind": "Worded", "word": "any"}},
    {"name": "worded-client-encode", "use": "/paths/~1worded/post request_body", "surface": "client", "op": "encode",
     "value": {"result": "worded-server-decode", "attr": "value"}},
    {"name": "rated-server-decode", "use": "/paths/~1rated/post request_body", "op": "decode", "value": {"ratio": 1.5}},
    {"name": "rated-client-encode", "use": "/paths/~1rated/post request_body", "surface": "client", "op": "encode",
     "value": {"result": "rated-server-decode", "attr": "value"}},
    {"name": "holder-client-encode-defaults", "use": "/paths/~1holders/post request_body", "surface": "client", "op": "encode",
     "value": {"call": "Holder", "args": {}}}
  ]
}
