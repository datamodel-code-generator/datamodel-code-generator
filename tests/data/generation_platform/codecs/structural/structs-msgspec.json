{
  "backend": "msgspec.Struct",
  "package": "codec_structs_msgspec",
  "scopes": ["schemas", "paths"],
  "strategies": true,
  "options": {"use_annotated": true, "field_constraints": true, "use_standard_primitive_types": true, "output_datetime_class": "datetime"},
  "cases": [
    {"name": "holder-server-decode", "use": "/paths/~1holders/post request_body", "op": "decode",
     "value": {"pet": {"size": "small", "contact": "c"}, "address": "10.0.0.1", "zz": 1}},
    {"name": "holder-server-response", "use": "/paths/~1holders/post response_body 200", "op": "encode",
     "value": {"result": "holder-server-decode", "attr": "value"}},
    {"name": "holder-server-decode-large", "use": "/paths/~1holders/post request_body", "op": "decode", "value": {"pet": {"size": "large"}}},
    {"name": "holder-server-response-defaults", "use": "/paths/~1holders/post response_body 200", "op": "encode", "value": {"call": "Holder", "args": {}}},
    {"name": "limits-server-decode", "use": "/paths/~1limits/post request_body", "op": "decode", "value": {"low": 2, "name": "abc"}},
    {"name": "limits-client-decode", "use": "/paths/~1limits/post response_body 200", "surface": "client", "op": "decode",
     "value": {"id": 1, "low": 2, "name": "abc"}},
    {"name": "coded-server-decode", "use": "/paths/~1coded/post request_body", "op": "decode",
     "value": {"code": "abc", "low": 1, "high": 9, "ratio": 1.5, "name": "ab", "tags": ["x"], "scores": {"a": 1}}},
    {"name": "coded-server-response", "use": "/paths/~1coded/post response_body 200", "op": "encode",
     "value": {"result": "coded-server-decode", "attr": "value"}},
    {"name": "batch-server-decode", "use": "/paths/~1batches/post request_body", "op": "decode",
     "value": {"entries": [{"amount": "1.5"}], "index": {"k": {"amount": "2"}}, "a.b": "3"}},
    {"name": "batch-server-decode-bad-entry", "use": "/paths/~1batches/post request_body", "op": "decode",
     "value": {"entries": [{"amount": "1.5"}, {"amount": "x"}]}},
    {"name": "batch-server-decode-bad-index", "use": "/paths/~1batches/post request_body", "op": "decode",
     "value": {"index": {"k": {"amount": "x"}}}},
    {"name": "batch-server-decode-bad-dotted", "use": "/paths/~1batches/post request_body", "op": "decode", "value": {"a.b": "x"}},
    {"name": "stamps-server-decode", "use": "/paths/~1stamps/post request_body", "op": "decode", "value": {"when": "2020-01-02T03:04:05Z"}},
    {"name": "rated-server-decode", "use": "/paths/~1rated/post request_body", "op": "decode", "value": {"ratio": 1.5}},
    {"name": "rated-server-decode-bad", "use": "/paths/~1rated/post request_body", "op": "decode", "value": {"ratio": 2.5}},
    {"name": "moment-server-decode-now", "use": "/paths/~1moments/post request_body", "op": "decode", "value": {"at": "now"}},
    {"name": "moment-server-decode-time", "use": "/paths/~1moments/post request_body", "op": "decode", "value": {"at": "2020-01-02T03:04:05Z"}},
    {"name": "worded-server-decode", "use": "/paths/~1worded/post request_body", "op": "decode", "value": {"word": "any", "level": 0}},
    {"name": "worded-server-decode-other", "use": "/paths/~1worded/post request_body", "op": "decode", "value": {"word": "x", "level": 5}},
    {"name": "wallet-server-decode", "use": "/paths/~1wallets/post request_body", "op": "decode",
     "value": {"coin": {"value": 10}, "address": "10.0.0.1"}},
    {"name": "wallet-server-response", "use": "/paths/~1wallets/post response_body 200", "op": "encode",
     "value": {"result": "wallet-server-decode", "attr": "value"}},
    {"name": "wallet-server-decode-float-tag", "use": "/paths/~1wallets/post request_body", "op": "decode", "value": {"coin": {"value": 10.0}}}
  ]
}
