{
  "backend": "dataclasses.dataclass",
  "package": "codec_stdlib_startup",
  "scopes": ["schemas", "paths", "api"],
  "options": {"use_standard_primitive_types": true, "use_unique_items_as_set": true, "output_datetime_class": "datetime",
              "field_extra_keys": ["init", "kw_only"]},
  "startup": [
    {"name": "matching", "use": "/paths/~1tickets/post request_body"},
    {"name": "converter", "use": "/paths/~1tickets/post request_body", "binding": {"converter_strategy": "pydantic_type_adapter"}},
    {"name": "backend", "use": "/paths/~1tickets/post request_body", "binding": {"backend": "typing.TypedDict"}},
    {"name": "bundle-direction", "use": "/paths/~1tickets/post request_body", "bundle": "response", "decode": {}},
    {"name": "missing-model", "use": "/paths/~1tickets/post request_body", "models": {"models:Ticket": ""}},
    {"name": "not-dataclass", "use": "/paths/~1tickets/post request_body",
     "models": {"models:Ticket": "tests.data.python.model_codec_base:AliasPet"}},
    {"name": "init-disagrees", "use": "/paths/~1tickets/post request_body",
     "models": {"models:Ticket": "tests.data.python.model_codec_stdlib:InitTicket"}},
    {"name": "required-disagrees", "use": "/paths/~1tickets/post request_body",
     "models": {"models:Ticket": "tests.data.python.model_codec_stdlib:RequiredTicket"}},
    {"name": "unbound-required", "use": "/paths/~1tickets/post request_body",
     "models": {"models:Ticket": "tests.data.python.model_codec_stdlib:OwnedTicket"}},
    {"name": "unresolved-annotation", "use": "/paths/~1tickets/post request_body",
     "models": {"models:Ticket": "tests.data.python.model_codec_stdlib:UnresolvedTicket"}},
    {"name": "leaf-disagrees", "use": "/paths/~1tickets/post request_body",
     "models": {"models:Ticket": "tests.data.python.model_codec_stdlib:ListTicket"}},
    {"name": "bytes-leaf", "use": "/paths/~1tickets/post request_body",
     "models": {"models:Ticket": "tests.data.python.model_codec_stdlib:BytesTicket"}},
    {"name": "union-disagrees", "use": "/paths/~1tickets/post request_body",
     "models": {"models:Ticket": "tests.data.python.model_codec_stdlib:ChoiceTicket"}},
    {"name": "container-disagrees", "use": "/paths/~1records/put request_body",
     "models": {"models:Record": "tests.data.python.model_codec_stdlib:SetRecord"}},
    {"name": "key-disagrees", "use": "/paths/~1keyed/post request_body",
     "models": {"models:Keyed": "tests.data.python.model_codec_stdlib:NumberKeyed"}},
    {"name": "constructor-refuses", "use": "/paths/~1tickets/post request_body",
     "models": {"models:Ticket": "tests.data.python.model_codec_stdlib:CheckedTicket"}, "decode": {"label": "bad"}},
    {"name": "native-gap", "use": "/paths/~1records/put request_body", "binding": {"projection_mode": "native"},
     "decode": {"name": "a"}},
    {"name": "relaxed-union", "use": "/paths/~1leaves/post request_body", "decode": {"choice": true},
     "patch": {"uri": "https://dcg.invalid/inputs/root", "pointer": "/components/schemas/Leaves/properties/choice", "keyword": "oneOf", "value": [{"type": "string"}, {"type": "integer"}, {"type": "boolean"}]}},
    {"name": "relaxed-leaf", "use": "/paths/~1records/put response_body 200", "surface": "client", "decode": {"name": 5, "stamp": "s"},
     "patch": {"uri": "https://dcg.invalid/inputs/root", "pointer": "/components/schemas/Record/properties/name", "keyword": "type", "value": ["string", "integer"]}},
    {"name": "relaxed-tuple", "use": "/paths/~1leaves/post request_body", "decode": {"pair": [1]},
     "patch": {"uri": "https://dcg.invalid/inputs/root", "pointer": "/components/schemas/Leaves/properties/pair", "keyword": "minItems", "value": 1}},
    {"name": "relaxed-key", "use": "/paths/~1keyed/post request_body", "decode": {"by_color": {"blue": 1}},
     "patch": {"uri": "https://dcg.invalid/inputs/root", "pointer": "/components/schemas/Keyed/properties/by_color", "keyword": "propertyNames", "value": {}}}
  ]
}
