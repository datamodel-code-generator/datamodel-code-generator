{
  "options": {
    "base_class_map": {
      "Owner": "app.bases.Base"
    }
  },
  "bindings": true,
  "refusal": {
    "config": {
      "builtin_codec_compatibility": []
    }
  },
  "config": {
    "builtin_codec_compatibility": [
      {
        "name": "owners",
        "backend": "pydantic_v2.BaseModel",
        "schemas": [
          {
            "pointer": "/components/schemas/Owner"
          }
        ]
      }
    ]
  },
  "declarations": {
    "adapters": [
      {
        "kind": "model",
        "name": "pet-model",
        "import_ref": "app.codecs:keeper_model",
        "capabilities": {
          "record": "CodecCapabilities",
          "backends": [
            "pydantic_v2.BaseModel"
          ],
          "native_kinds": [
            "model"
          ]
        },
        "uses": [
          {
            "operation": "/paths/~1adapted/post",
            "role": "request_body",
            "media_type": "application/json"
          }
        ]
      }
    ]
  }
}
