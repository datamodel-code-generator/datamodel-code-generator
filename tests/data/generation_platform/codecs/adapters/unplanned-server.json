{
 "config": {
  "selection": {
   "exclude_operations": [
    "/paths/~1pairs/get"
   ],
   "reason": "Only the cookie reaches the parameter adapter"
  }
 },
 "declarations": {
  "adapters": [
   {
    "kind": "parameter",
    "name": "json-cookie",
    "import_ref": "app.codecs:json_cookie",
    "capabilities": {
     "record": "ParameterCodecCapabilities",
     "locations": [
      "cookie"
     ],
     "styles": [
      "form"
     ],
     "explode_values": [
      false
     ],
     "value_kinds": [
      "array"
     ],
     "supports_empty_containers": true
    },
    "uses": [
     {
      "schema": {
       "pointer": "/components/schemas/Tags"
      },
      "direction": "request"
     }
    ]
   }
  ]
 }
}
