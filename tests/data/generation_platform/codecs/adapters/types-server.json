{
  "scopes": ["schemas", "paths"],
  "options": {"collapse_root_models": true, "enum_field_as_literal": "all"},
  "config": {"selection": {"exclude_operations": ["/paths/~1ordered/get"], "reason": "The header has no generated type"}},
  "declarations": {
    "adapters": [
      {
        "kind": "model",
        "name": "holder-model",
        "import_ref": "app.codecs:keeper_model",
        "capabilities": {"record": "CodecCapabilities", "backends": ["pydantic_v2.BaseModel"], "native_kinds": ["model"]},
        "uses": [{"schema": {"pointer": "/components/schemas/Holder"}, "direction": "request"}]
      }
    ]
  },
  "cases": [
    {"name": "code", "use": "/paths/~1scalars/post parameter query code", "op": "decode", "value": "abc"},
    {"name": "code-invalid", "use": "/paths/~1scalars/post parameter query code", "op": "decode", "value": "ABC"},
    {"name": "price", "use": "/paths/~1scalars/post parameter query price", "op": "decode", "value": "9.5"},
    {"name": "pet", "use": "/paths/~1scalars/post parameter query pet", "op": "decode", "value": {"kind": "dog"}},
    {"name": "holder", "use": "/paths/~1scalars/post request_body", "op": "decode",
     "value": {"pets": [{"kind": "cat"}, {"kind": "dog"}], "label": "abcd", "mode": "a"}},
    {"name": "name", "use": "/paths/~1scalars/post response_body 201", "op": "outbound", "value": null}
  ]
}
