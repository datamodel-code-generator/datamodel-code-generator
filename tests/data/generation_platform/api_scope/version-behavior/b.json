{
  "openapi": "3.2.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "info": {
    "title": "Second root",
    "version": "1"
  },
  "paths": {
    "/new": {
      "get": {
        "operationId": "new",
        "responses": {
          "200": {
            "description": "A referenced string with a sibling constraint",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "value": {
                      "$ref": "#/components/schemas/Limited"
                    }
                  },
                  "required": [
                    "value"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/stream": {
      "get": {
        "operationId": "stream",
        "responses": {
          "200": {
            "description": "Independent sequential JSON items",
            "content": {
              "application/x-ndjson": {
                "itemSchema": {
                  "type": "object",
                  "properties": {
                    "stream_only": {
                      "type": "integer"
                    }
                  },
                  "required": [
                    "stream_only"
                  ]
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Value": {
        "type": "string"
      },
      "Limited": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Value",
            "maxLength": 3
          }
        ]
      }
    }
  }
}
