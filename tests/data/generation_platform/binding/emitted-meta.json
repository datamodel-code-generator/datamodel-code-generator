            "exclusiveMaximum": 9.75,
            "multipleOf": 0.5
          },
          "nested": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "items": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 2,
                "maxLength": 8,
                "pattern": "^a"
              }
            }
          },
          "mapping": {
            "type": "object",
            "additionalProperties": {
