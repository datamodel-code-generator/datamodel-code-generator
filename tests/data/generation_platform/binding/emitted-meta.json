              {
                "type": "string",
                "minLength": 3
              },
              {
                "type": "integer",
                "maximum": 5
              }
            ]
          },
          "nullable": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 2
          },
          "optional": {
            "type": "string",
            "maxLength": 6
          },
          "rank": {
            "type": [
              "integer",
              "number"
            ],
            "description": "rank"
          }
        },
        "required": [
          "integer",
          "number",
          "nested",
          "mapping",
          "choice",
          "nullable"
