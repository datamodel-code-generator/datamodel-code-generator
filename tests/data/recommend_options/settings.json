{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Settings",
  "type": "object",
  "properties": {
    "env": {
      "type": "object",
      "patternProperties": {
        "^[A-Z_]+$": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "limits": {
      "type": "object",
      "patternProperties": {
        "^[a-z]+$": {
          "type": "integer"
        }
      },
      "additionalProperties": {
        "type": "boolean"
      }
    },
    "ports": {
      "$ref": "#/definitions/PortList",
      "uniqueItems": true
    }
  },
  "definitions": {
    "PortList": {
      "type": "array",
      "items": {
        "type": "integer"
      }
    }
  }
}
