{% for decorator in decorators -%}
{{ decorator }}
{% endfor -%}
@dataclass
class {{ class_name }}:
{%- if description %}
    """{{ description }}"""
{%- endif %}
{%- for field in fields %}
    {{ field.name }}: {{ field.type_hint }}
{%- if field.docstring %}
    """{{ field.docstring }}"""
{%- endif %}
{%- endfor %}
