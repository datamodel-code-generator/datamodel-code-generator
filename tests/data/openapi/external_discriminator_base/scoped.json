            "properties": {
              "bark": {
                "type": "string"
              }
            }
          }
        ]
      },
      "Cat": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Base"
          },
          {
            "type": "object",
            "properties": {
              "meow": {
                "type": "string"
              }
            }
          }
        ]
      },
      "Wrapper": {
        "type": "object",
        "properties": {
          "local": {
            "$ref": "#/components/schemas/Base"
          },
          "left": {
            "$ref": "./left/base.json#/components/schemas/Base"
          },
          "right": {
            "$ref": "./right/base.json#/components/schemas/Base"
          }
        },
        "required": [
          "local",
          "left",
          "right"
        ]
      }
    }
  }
