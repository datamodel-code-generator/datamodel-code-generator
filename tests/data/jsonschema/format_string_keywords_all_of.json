{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Document",
  "type": "object",
  "properties": {
    "id": {"$ref": "#/definitions/Identifier"},
    "day": {"$ref": "#/definitions/Day"},
    "mail": {"$ref": "#/definitions/Mail"}
  },
  "definitions": {
    "Text": {"type": "string"},
    "Identifier": {
      "allOf": [{"$ref": "#/definitions/Text"}, {"minLength": 8, "maxLength": 36}],
      "format": "uuid"
    },
    "Day": {
      "allOf": [{"$ref": "#/definitions/Text"}, {"pattern": "^20[0-9]{2}-"}],
      "format": "date"
    },
    "Mail": {
      "allOf": [{"$ref": "#/definitions/Text"}, {"maxLength": 40}],
      "format": "email"
    }
  }
}
