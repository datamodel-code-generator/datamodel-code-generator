{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "DisposableBag": {
      "type": "object",
      "patternProperties": {
        "^item_": {
          "type": "integer"
        }
      },
      "additionalProperties": {
        "type": "integer"
      }
    },
    "Survivor": {
      "type": "object",
      "minProperties": 1,
      "properties": {
        "value": {
          "type": "string"
        }
      }
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/DisposableBag"
    },
    {
      "$ref": "#/$defs/Survivor"
    }
  ]
}
