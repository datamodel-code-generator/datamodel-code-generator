{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Decimal": {
      "type": "object",
      "properties": {
        "digits": {
          "type": "string"
        }
      }
    },
    "Item": {
      "type": "object",
      "properties": {
        "amount": {
          "type": "string"
        },
        "when": {
          "type": "string"
        },
        "date": {
          "type": "string"
        }
      }
    },
    "Event": {
      "type": "object",
      "properties": {
        "str": {
          "type": "integer"
        },
        "label": {
          "type": "integer"
        }
      }
    },
    "Concert": {
      "allOf": [
        {
          "$ref": "#/$defs/Event"
        },
        {
          "type": "object",
          "properties": {
            "label": {
              "type": "string"
            }
          }
        }
      ]
    }
  },
  "$ref": "#/$defs/Concert"
}
