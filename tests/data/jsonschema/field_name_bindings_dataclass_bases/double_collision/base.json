{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Holder": {
      "type": "object",
      "properties": {
        "date": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "Base": {
      "type": "object",
      "properties": {
        "str": {
          "type": "integer"
        },
        "pair": {
          "type": "array",
          "prefixItems": [
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": [
                "string",
                "null"
              ]
            }
          ],
          "minItems": 2,
          "maxItems": 2
        }
      }
    }
  }
}
