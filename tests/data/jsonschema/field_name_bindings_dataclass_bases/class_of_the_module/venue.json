{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Place": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        }
      }
    },
    "Concert": {
      "allOf": [
        {
          "$ref": "event.json#/$defs/Event"
        },
        {
          "type": "object",
          "properties": {
            "where": {
              "$ref": "#/$defs/Place"
            }
          }
        }
      ]
    }
  }
}
