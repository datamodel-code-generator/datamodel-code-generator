{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Place": {
      "type": "object",
      "properties": {
        "str": {
          "type": "string"
        }
      }
    },
    "Concert": {
      "allOf": [
        {
          "$ref": "event.json"
        },
        {
          "type": "object",
          "properties": {
            "label": {
              "type": "string"
            },
            "when": {
              "type": "string",
              "format": "date"
            },
            "count": {
              "type": "integer"
            }
          }
        }
      ]
    }
  }
}
