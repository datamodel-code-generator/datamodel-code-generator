{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "a": { "$ref": "#/$defs/ModelA" },
    "b": { "$ref": "#/$defs/ModelB" },
    "c": { "$ref": "#/$defs/ModelC" }
  },
  "$defs": {
    "ModelA": {
      "anyOf": [
        { "type": "string" },
        { "$ref": "#/$defs/ModelB" },
        { "$ref": "#/$defs/ModelC" }
      ]
    },
    "ModelB": {
      "anyOf": [{ "type": "boolean" }]
    },
    "ModelC": {
      "anyOf": [
        { "type": "integer" },
        { "$ref": "#/$defs/ModelB" }
      ]
    }
  }
}
