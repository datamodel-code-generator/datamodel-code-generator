{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "data": {
      "$ref": "#/$defs/JsonValue"
    },
    "wrapped": {
      "$ref": "#/$defs/Wrapper"
    }
  },
  "required": ["data"],
  "$defs": {
    "JsonValue": {
      "anyOf": [
        { "type": "string" },
        { "type": "number" },
        { "type": "boolean" },
        {
          "type": "array",
          "items": { "$ref": "#/$defs/JsonValue" }
        },
        {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/JsonValue" }
        }
      ]
    },
    "Wrapper": {
      "anyOf": [
        { "type": "integer" },
        { "$ref": "#/$defs/JsonValue" }
      ]
    }
  }
}
