{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "Item": {
      "type": "object",
      "properties": {
        "id": {"type": "string", "readOnly": true},
        "name": {"type": "string"}
      }
    },
    "Items": {"type": "array", "items": {"$ref": "#/definitions/Item"}},
    "Alias": {"$ref": "#/definitions/Item"},
    "Listed": {"allOf": [{"$ref": "#/definitions/Items"}]},
    "Inline": {
      "allOf": [
        {
          "type": "object",
          "properties": {
            "id": {"type": "string", "readOnly": true},
            "name": {"type": "string"}
          }
        }
      ]
    },
    "Holder": {
      "type": "object",
      "properties": {
        "list": {"type": "array", "items": {"$ref": "#/definitions/Item", "minLength": 1}},
        "alias": {"type": "array", "items": {"$ref": "#/definitions/Alias", "minLength": 1}},
        "inline": {"type": "array", "items": {"$ref": "#/definitions/Inline", "minLength": 1}},
        "pair": {
          "type": "array",
          "items": [{"$ref": "#/definitions/Item", "minLength": 1}, {"type": "string"}],
          "additionalItems": {"$ref": "#/definitions/Item", "minLength": 1}
        },
        "union": {"anyOf": [{"$ref": "#/definitions/Item", "minLength": 1}, {"type": "integer"}]},
        "choice": {"oneOf": [{"$ref": "#/definitions/Item", "minLength": 1}, {"type": "boolean"}]},
        "count": {"type": "integer"}
      }
    },
    "Wrapping": {
      "type": "object",
      "properties": {
        "rows": {"type": "array", "items": {"$ref": "#/definitions/Items", "minItems": 1}},
        "listed": {"type": "array", "items": {"$ref": "#/definitions/Listed", "minItems": 1}}
      }
    }
  },
  "type": "object",
  "properties": {
    "holder": {"$ref": "#/definitions/Holder"},
    "wrapping": {"$ref": "#/definitions/Wrapping"},
    "item": {"$ref": "#/definitions/Item"}
  }
}
