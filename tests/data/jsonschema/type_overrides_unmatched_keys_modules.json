{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Order",
  "type": "object",
  "properties": {
    "item": {
      "type": "object",
      "properties": {
        "sku": {
          "type": "string"
        }
      }
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Item"
      }
    },
    "rank": {
      "$ref": "#/$defs/stats.Rank"
    }
  },
  "$defs": {
    "Item": {
      "type": "object",
      "properties": {
        "price": {
          "type": "string"
        }
      }
    },
    "stats.Rank": {
      "type": "object",
      "properties": {
        "score": {
          "type": "integer"
        }
      }
    }
  }
}