{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UnicodeMeasurement",
  "type": "object",
  "properties": {
    "unit": {
      "type": "string",
      "enum": [
        "m²",
        "m³"
      ]
    },
    "language": {
      "type": "string",
      "const": "हिन्दी"
    },
    "code": {
      "type": "string",
      "pattern": "^\\w+$"
    }
  },
  "required": [
    "unit",
    "language",
    "code"
  ]
}
