{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "pkg.Report": {"type": "object", "properties": {"warn": {"$ref": "#/$defs/pkg.Warn"}, "kind": {"$ref": "#/$defs/pkg.Warn.Kind"}}},
    "pkg.Warn": {"type": "object", "properties": {"count": {"type": "integer"}}},
    "pkg.Warn.Kind": {"type": "string", "enum": ["low", "high"], "const": "high"},
    "pkg.Warn.Detail": {"type": "object", "properties": {"message": {"type": "string"}}},
    "pkg.api.Order": {"type": "object", "properties": {"detail": {"$ref": "#/$defs/pkg.Warn.Detail"}}}
  }
}
