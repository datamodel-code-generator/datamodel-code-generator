{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Base": {
      "type": "object",
      "properties": {
        "a": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "a"
      ]
    },
    "Handle": {
      "type": "object",
      "properties": {
        "queue": {
          "type": "string",
          "customTypePath": "queue.Queue"
        }
      },
      "required": [
        "queue"
      ]
    },
    "Both": {
      "allOf": [
        {
          "$ref": "#/$defs/Base"
        },
        {
          "$ref": "#/$defs/Handle"
        }
      ]
    }
  }
}
