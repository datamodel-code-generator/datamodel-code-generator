{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Defaults",
  "type": "object",
  "properties": {
    "values": {
      "type": "object",
      "properties": {
        "left": {
          "$ref": "#/$defs/leaf"
        }
      }
    }
  },
  "$defs": {
    "leaf": {
      "type": "object",
      "properties": {
        "Bar": {
          "allOf": [
            {
              "$ref": "#/$defs/Bar"
            }
          ],
          "default": {
            "x": 1
          }
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Bar"
          },
          "default": [
            {
              "x": 1
            }
          ]
        }
      }
    },
    "Bar": {
      "type": "object",
      "properties": {
        "x": {
          "type": "integer"
        }
      }
    }
  }
}
