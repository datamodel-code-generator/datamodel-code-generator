{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Root",
  "type": "object",
  "properties": {
    "pet": {
      "oneOf": [{"$ref": "#/$defs/Cat"}, {"$ref": "#/$defs/Dog"}],
      "discriminator": {"propertyName": "kind", "mapping": {"cat": "#/$defs/Cat", "dog": "#/$defs/Dog"}}
    }
  },
  "$defs": {
    "PetKind": {"type": "string", "enum": ["cat", "dog"]},
    "Cat": {
      "type": "object",
      "properties": {"kind": {"$ref": "#/$defs/PetKind", "const": "cat"}},
      "required": ["kind"]
    },
    "Dog": {
      "type": "object",
      "properties": {"kind": {"type": "string", "enum": ["cat", "dog"], "const": "dog"}},
      "required": ["kind"]
    }
  }
}
