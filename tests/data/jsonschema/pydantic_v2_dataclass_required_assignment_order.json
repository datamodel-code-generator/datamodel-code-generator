{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Pet",
  "type": "object",
  "required": ["plain", "first-name", "count"],
  "properties": {
    "plain": {"type": "string"},
    "nick": {"type": "string", "default": "x"},
    "first-name": {"type": "string"},
    "opt-alias": {"type": "string"},
    "count": {"type": "integer", "minimum": 1}
  },
  "definitions": {
    "Base": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "name": {"type": "string", "description": "Name of the object"},
        "kind": {"type": "string", "description": "Kind of the object"}
      }
    },
    "Child": {
      "allOf": [
        {"$ref": "#/definitions/Base"},
        {
          "type": "object",
          "required": ["kind"],
          "properties": {"kind": {"type": "string", "const": "child"}}
        }
      ]
    }
  }
}
