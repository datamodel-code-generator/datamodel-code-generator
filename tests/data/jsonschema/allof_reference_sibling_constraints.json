{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Measurement",
  "type": "object",
  "definitions": {
    "Count": {
      "type": "integer"
    },
    "Code": {
      "type": "string",
      "pattern": "^[A-Z]"
    },
    "Tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 3
    },
    "Point": {
      "type": "object",
      "properties": {
        "x": {
          "type": "integer"
        }
      }
    },
    "Score": {
      "allOf": [
        {
          "$ref": "#/definitions/Count"
        }
      ],
      "maximum": 100
    },
    "Status": {
      "type": "string",
      "enum": [
        "open",
        "closed"
      ]
    },
    "Pair": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "contains": true
    }
  },
  "properties": {
    "count": {
      "allOf": [
        {
          "$ref": "#/definitions/Count"
        }
      ],
      "minimum": 5
    },
    "code": {
      "allOf": [
        {
          "$ref": "#/definitions/Code"
        }
      ],
      "maxLength": 3
    },
    "tags": {
      "allOf": [
        {
          "$ref": "#/definitions/Tags"
        }
      ],
      "minItems": 1,
      "maxItems": 5
    },
    "score": {
      "$ref": "#/definitions/Score"
    },
    "counts": {
      "type": "array",
      "items": {
        "allOf": [
          {
            "$ref": "#/definitions/Count"
          }
        ],
        "minimum": 5
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": {
        "allOf": [
          {
            "$ref": "#/definitions/Count"
          }
        ],
        "maximum": 10
      }
    },
    "point": {
      "allOf": [
        {
          "$ref": "#/definitions/Point"
        }
      ],
      "minimum": 5
    },
    "label": {
      "allOf": [
        {
          "$ref": "#/definitions/Count"
        }
      ],
      "maxLength": 2
    },
    "status": {
      "allOf": [
        {
          "$ref": "#/definitions/Status"
        }
      ],
      "maxLength": 8
    },
    "pair": {
      "allOf": [
        {
          "$ref": "#/definitions/Pair"
        }
      ],
      "maxItems": 2
    },
    "single": {
      "allOf": [
        {
          "$ref": "#/definitions/Pair"
        }
      ],
      "maxItems": 1
    },
    "ref_pair": {
      "$ref": "#/definitions/Pair",
      "contains": {
        "const": "a"
      },
      "minContains": 0,
      "maxItems": 2
    }
  }
}
