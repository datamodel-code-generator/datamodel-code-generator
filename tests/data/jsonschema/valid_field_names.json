{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Account",
  "type": "object",
  "required": ["account_id", "display_name", "is_active", "version2"],
  "properties": {
    "account_id": {
      "type": "integer"
    },
    "display_name": {
      "type": "string"
    },
    "is_active": {
      "type": "boolean"
    },
    "version2": {
      "type": "string"
    },
    "profile": {
      "type": "object",
      "required": ["created_at", "email_address"],
      "properties": {
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "email_address": {
          "type": "string",
          "format": "email"
        }
      }
    }
  }
}
