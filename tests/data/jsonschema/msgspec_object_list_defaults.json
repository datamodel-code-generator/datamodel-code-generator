    "nullable_items": {"type": ["array", "null"], "items": {"anyOf": [{"$ref": "#/$defs/Item"}, {"type": "null"}]}, "default": [{"n": 2}, {"n": 1}]},
    "nullable_container": {"type": ["array", "null"], "items": {"$ref": "#/$defs/Item"}, "default": [{"n": 5}]},
    "nonnull_nullable_items": {"type": "array", "items": {"anyOf": [{"$ref": "#/$defs/Item"}, {"type": "null"}]}, "default": [{"n": 6}]},
    "empty": {"type": "array", "items": {"$ref": "#/$defs/Item"}, "default": []},
    "direct_item": {"$ref": "#/$defs/Item", "default": {"n": 8}},
    "count": {"type": "integer", "default": 9},
    "numbers": {"type": "array", "items": {"type": "integer"}, "default": [3, 1, 2]},
    "matrix": {"type": "array", "items": {"type": "array", "items": {"$ref": "#/$defs/Item"}}, "default": [[{"n": 4}], [{"n": 2}, {"n": 1}]]},
    "cube": {"type": "array", "items": {"type": "array", "items": {"type": "array", "items": {"$ref": "#/$defs/Item"}}}, "default": [[[{"n": 7}]], [[{"n": 6}, {"n": 5}]]]},
    "scalar_cube": {"type": "array", "items": {"type": "array", "items": {"type": "array", "items": {"type": "integer"}}}, "default": [[[3, 1], [2]]]}
  }
}
