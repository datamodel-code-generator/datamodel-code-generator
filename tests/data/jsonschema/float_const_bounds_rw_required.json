{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Model",
  "type": "object",
  "properties": {"child": {"$ref": "#/$defs/Child"}},
  "$defs": {
    "Base": {
      "type": "object",
      "properties": {
        "id": {"type": "integer", "readOnly": true},
        "name": {"type": "string"},
        "ratio": {"type": "number", "const": 0.5}
      }
    },
    "Child": {"allOf": [{"$ref": "#/$defs/Base"}], "required": ["ratio"]}
  }
}
