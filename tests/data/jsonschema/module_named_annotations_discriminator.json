{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Catalog",
  "type": "object",
  "properties": {"n": {"type": "integer"}},
  "$defs": {
    "api.Pet": {
      "oneOf": [{"$ref": "#/$defs/api.Cat"}, {"$ref": "#/$defs/api.Dog"}],
      "discriminator": {"propertyName": "kind", "mapping": {"cat": "#/$defs/api.Cat", "dog": "#/$defs/api.Dog"}}
    },
    "api.Cat": {
      "type": "object",
      "properties": {"kind": {"$ref": "#/$defs/annotations.Kind"}, "meow": {"type": "string"}},
      "required": ["kind"]
    },
    "api.Dog": {
      "type": "object",
      "properties": {"kind": {"$ref": "#/$defs/annotations.Kind"}, "bark": {"type": "string"}},
      "required": ["kind"]
    },
    "annotations.Kind": {"type": "string", "enum": ["cat", "dog"]}
  }
}
