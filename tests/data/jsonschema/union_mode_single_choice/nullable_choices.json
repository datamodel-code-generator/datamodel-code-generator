{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Doc",
  "type": "object",
  "properties": {
    "value": {"anyOf": [{"$ref": "#/$defs/Value"}, {"type": "null"}]},
    "id": {"anyOf": [{"$ref": "#/$defs/Id"}, {"type": "null"}]},
    "nested": {"anyOf": [{"anyOf": [{"type": "integer"}, {"type": "string"}]}, {"type": "null"}]},
    "count": {"anyOf": [{"type": "integer"}, {"type": "null"}]},
    "code": {"anyOf": [{"type": "string", "minLength": 2}, {"type": "null"}]},
    "kind": {"anyOf": [{"type": "string", "enum": ["x", "y"]}, {"type": "null"}]},
    "items": {"anyOf": [{"type": "array", "items": {"type": "integer"}}, {"type": "null"}]},
    "written": {"anyOf": [{"type": "integer", "x-python-type": "int | str | None"}, {"type": "null"}]},
    "writtenSingle": {"anyOf": [{"x-python-type": "int | None"}, {"type": "null"}]}
  },
  "$defs": {
    "Value": {"anyOf": [{"type": "integer"}, {"type": "string"}]},
    "Id": {"type": "integer"}
  }
}
