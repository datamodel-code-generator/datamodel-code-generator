{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "PodSpec": {
      "type": "object",
      "properties": {"containers": {"type": "array", "items": {"type": "string"}}},
      "required": ["containers"]
    },
    "Template": {
      "type": "object",
      "properties": {
        "spec": {"$ref": "#/$defs/PodSpec", "default": {}},
        "kind": {"type": ["object", "null"], "properties": {"a": {"type": "string"}}, "required": ["a"], "default": {}}
      }
    },
    "Deployment": {
      "type": "object",
      "allOf": [{"$ref": "#/$defs/Template"}],
      "properties": {
        "spec": {"description": "The pod spec."},
        "kind": {"type": "object"}
      },
      "required": ["kind"]
    }
  }
}
