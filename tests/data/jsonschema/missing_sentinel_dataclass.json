{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Pet",
  "type": "object",
  "definitions": {
    "Animal": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": {"type": "integer", "minimum": 1},
        "note": {"type": ["string", "null"], "maxLength": 20}
      }
    }
  },
  "allOf": [{"$ref": "#/definitions/Animal"}],
  "required": ["name", "owner"],
  "properties": {
    "name": {"type": "string", "minLength": 1},
    "owner": {"type": ["string", "null"]},
    "tag": {"type": "string", "maxLength": 5},
    "pet-age": {"type": "integer", "minimum": 0},
    "nick": {"type": ["string", "null"]},
    "legs": {"type": "integer", "default": 4}
  }
}
