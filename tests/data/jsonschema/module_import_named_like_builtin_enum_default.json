{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Root",
  "type": "object",
  "properties": {"holder": {"$ref": "#/definitions/holder.Holder"}},
  "definitions": {
    "holder.Holder": {
      "type": "object",
      "properties": {
        "tags": {"type": "array", "items": {"type": "string"}},
        "pop": {"$ref": "#/definitions/app.list.Pop", "default": "first"},
        "pops": {"type": "array", "items": {"$ref": "#/definitions/app.list.Pop"}, "default": ["second", "first"]}
      }
    },
    "app.list.Pop": {"type": "string", "enum": ["first", "second"]}
  }
}
