{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Entry": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Link"
      }
    },
    "Chain": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Link"
      }
    },
    "Link": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/Chain"
              },
              {
                "$ref": "#/$defs/Knot"
              }
            ]
          }
        }
      ]
    },
    "Knot": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Link"
      },
      "minItems": 2
    },
    "Holder": {
      "type": "object",
      "properties": {
        "l": {
          "$ref": "#/$defs/Link"
        }
      }
    }
  }
}
