{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Catalog",
  "description": "Labels by locale, then by key, beside the default locale.",
  "type": "object",
  "$defs": {
    "Label": {
      "type": "object",
      "properties": {
        "text": {"type": "string"},
        "lang": {"type": "string"}
      },
      "required": ["text"]
    },
    "Notes": {
      "description": "Notes by locale, then by key, beside the default locale.",
      "type": "object",
      "properties": {"default_locale": {"type": "string"}},
      "additionalProperties": {
        "allOf": [
          {"type": "object", "additionalProperties": {"$ref": "#/$defs/Label"}},
          {"type": "object", "additionalProperties": {"type": "object"}}
        ]
      }
    }
  },
  "properties": {
    "default_locale": {"type": "string"},
    "notes": {"$ref": "#/$defs/Notes"}
  },
  "additionalProperties": {
    "allOf": [
      {"type": "object", "additionalProperties": {"type": "object"}},
      {"type": "object", "additionalProperties": {"$ref": "#/$defs/Label"}}
    ]
  }
}
