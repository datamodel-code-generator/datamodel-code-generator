{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "QuotedPatternKeys",
  "type": "object",
  "properties": {
    "single": {
      "type": "object",
      "propertyNames": {"pattern": "^[a-z'*]+$"},
      "additionalProperties": {"type": "string"}
    },
    "double": {
      "type": "object",
      "propertyNames": {"pattern": "^[a-z\"*]+$"},
      "additionalProperties": {"type": "string"}
    },
    "both": {
      "type": "object",
      "propertyNames": {"pattern": "^[a-z'\"]+$"},
      "additionalProperties": {"type": "string"}
    }
  }
}
