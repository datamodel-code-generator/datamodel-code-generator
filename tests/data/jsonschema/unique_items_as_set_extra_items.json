{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Model",
  "type": "object",
  "properties": {
    "scalars": {
      "$ref": "#/$defs/Scalars"
    },
    "nested": {
      "$ref": "#/$defs/Nested"
    },
    "members": {
      "$ref": "#/$defs/Members"
    },
    "maps": {
      "$ref": "#/$defs/Maps"
    },
    "unique": {
      "$ref": "#/$defs/Unique"
    },
    "plain": {
      "$ref": "#/$defs/Plain"
    }
  },
  "$defs": {
    "Scalars": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string"
        }
      },
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "integer"
        },
        "uniqueItems": true
      }
    },
    "Nested": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string"
        }
      },
      "additionalProperties": {
        "type": "array",
        "uniqueItems": true,
        "items": {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "uniqueItems": true
        }
      }
    },
    "Members": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string"
        }
      },
      "additionalProperties": {
        "anyOf": [
          {
            "type": "array",
            "items": {
              "type": "integer"
            },
            "uniqueItems": true
          },
          {
            "type": "string"
          }
        ]
      }
    },
    "Maps": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string"
        }
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "uniqueItems": true
        }
      }
    },
    "Colors": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string"
        }
      },
      "additionalProperties": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/Color"
        },
        "uniqueItems": true
      }
    },
    "Color": {
      "type": "string",
      "enum": [
        "red",
        "green"
      ]
    },
    "Items": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string"
        }
      },
      "additionalProperties": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/Item"
        },
        "uniqueItems": true
      }
    },
    "Item": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer"
        }
      }
    },
    "Unique": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        }
      },
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "integer"
        },
        "uniqueItems": true
      }
    },
    "Plain": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        }
      },
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "integer"
        }
      }
    }
  }
}
