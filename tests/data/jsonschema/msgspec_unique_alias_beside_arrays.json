{
  "title": "Model",
  "type": "object",
  "properties": {
    "holder": {"$ref": "#/$defs/Holder"},
    "refused": {"$ref": "#/$defs/Refused"},
    "varied": {"$ref": "#/$defs/Varied"}
  },
  "$defs": {
    "Holder": {
      "type": "object",
      "properties": {
        "besideList": {
          "anyOf": [
            {"type": "array", "items": {"type": "integer"}, "uniqueItems": true},
            {"type": "array", "items": {"type": "integer"}}
          ]
        },
        "besideString": {
          "anyOf": [{"type": "array", "items": {"type": "integer"}, "uniqueItems": true}, {"type": "string"}]
        },
        "besideListAndPet": {
          "anyOf": [
            {"type": "array", "items": {"type": "integer"}, "uniqueItems": true},
            {"type": "array", "items": {"type": "integer"}},
            {"$ref": "#/$defs/Pet"}
          ]
        },
        "nestedLists": {
          "type": "array",
          "items": {
            "anyOf": [
              {"type": "array", "items": {"type": "integer"}, "uniqueItems": true},
              {"type": "array", "items": {"type": "integer"}}
            ]
          }
        },
        "pet": {"$ref": "#/$defs/Pet"},
        "nestedAnyOf": {
          "anyOf": [{"anyOf": [{"$ref": "#/$defs/UniqueInts"}]}, {"type": "array", "items": {"type": "integer"}}]
        }
      }
    },
    "Refused": {
      "type": "object",
      "properties": {
        "sharedBesideList": {"anyOf": [{"$ref": "#/$defs/Tags"}, {"type": "array", "items": {"type": "string"}}]},
        "shared": {"$ref": "#/$defs/Tags"},
        "besideUniqueList": {
          "anyOf": [
            {"type": "array", "items": {"type": "integer"}, "uniqueItems": true},
            {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
          ]
        }
      }
    },
    "Varied": {
      "type": "object",
      "properties": {
        "boundedBesideList": {
          "anyOf": [
            {"type": "array", "items": {"type": "integer"}, "uniqueItems": true, "minItems": 1},
            {"type": "array", "items": {"type": "integer"}}
          ]
        },
        "besideOtherItems": {
          "anyOf": [
            {"type": "array", "items": {"type": "integer"}, "uniqueItems": true},
            {"type": "array", "items": {"type": "string"}}
          ]
        },
        "besideListAndMixed": {
          "anyOf": [
            {"type": "array", "items": {"type": "integer"}, "uniqueItems": true},
            {"type": "array", "items": {"type": "integer"}},
            {"$ref": "#/$defs/Mixed"}
          ]
        },
        "besideListAlias": {
          "anyOf": [
            {"type": "array", "items": {"type": "integer"}, "uniqueItems": true},
            {"$ref": "#/$defs/IntList"},
            {"type": "array", "items": {"type": "integer"}}
          ]
        },
        "nullableBesideList": {
          "anyOf": [{"$ref": "#/$defs/NullableTags"}, {"type": "array", "items": {"type": "string"}}]
        }
      }
    },
    "Mixed": {"anyOf": [{"$ref": "#/$defs/Pet"}, {"type": "array", "items": {"type": "integer"}}, {"type": "string"}]},
    "IntList": {"type": "array", "items": {"type": "integer"}},
    "NullableTags": {"anyOf": [{"type": "array", "items": {"type": "string"}, "uniqueItems": true}, {"type": "null"}]},
    "Pet": {"type": "object", "properties": {"name": {"type": "string"}}},
    "UniqueInts": {"type": "array", "items": {"type": "integer"}, "uniqueItems": true},
    "Tags": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
  }
}
