{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "a.b.Warn": {
      "type": "object",
      "properties": {
        "count": {
          "type": "integer"
        },
        "order": {
          "$ref": "#/$defs/a.b.api.Order"
        }
      }
    },
    "a.b.Warn.Detail": {
      "type": "object",
      "properties": {
        "message": {
          "type": "string"
        }
      }
    },
    "a.b.api.Order": {
      "type": "object",
      "properties": {
        "detail": {
          "$ref": "#/$defs/a.b.Warn.Detail"
        },
        "warn": {
          "$ref": "#/$defs/a.b.Warn"
        }
      }
    },
    "a.b.report.Report": {
      "type": "object",
      "properties": {
        "detail": {
          "$ref": "#/$defs/a.b.Warn.Detail"
        }
      }
    },
    "a.c.Other": {
      "type": "object",
      "properties": {
        "detail": {
          "$ref": "#/$defs/a.b.Warn.Detail"
        }
      }
    },
    "a.b.sub.deep.Leaf": {
      "type": "object",
      "properties": {
        "detail": {
          "$ref": "#/$defs/a.b.Warn.Detail"
        }
      }
    }
  }
}
