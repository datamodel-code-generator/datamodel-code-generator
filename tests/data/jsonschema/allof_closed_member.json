{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Filters",
  "type": "object",
  "properties": {
    "closed": {
      "$ref": "#/$defs/ClosedFilters"
    },
    "nested": {
      "$ref": "#/$defs/NestedClosedFilters"
    },
    "merged": {
      "$ref": "#/$defs/MergedClosedFilters"
    }
  },
  "$defs": {
    "OpenFilters": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "status": {
          "type": "string"
        }
      }
    },
    "LimitedFilters": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "maxLength": 8
        }
      }
    },
    "ClosedFilters": {
      "allOf": [
        {
          "$ref": "#/$defs/OpenFilters"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "status": {
              "type": "string"
            },
            "owner": {
              "type": "string"
            }
          }
        }
      ]
    },
    "NestedClosedFilters": {
      "allOf": [
        {
          "$ref": "#/$defs/OpenFilters"
        },
        {
          "allOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "status": {
                  "type": "string"
                },
                "owner": {
                  "type": "string"
                }
              }
            }
          ]
        }
      ]
    },
    "MergedClosedFilters": {
      "allOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "status": {
              "type": "string"
            },
            "owner": {
              "type": "string"
            }
          }
        },
        {
          "$ref": "#/$defs/OpenFilters"
        },
        {
          "$ref": "#/$defs/LimitedFilters"
        }
      ]
    }
  }
}
