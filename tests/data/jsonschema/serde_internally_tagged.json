{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Drawing",
  "type": "object",
  "properties": {
    "shape": {
      "$ref": "#/$defs/Shape"
    },
    "shapes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Shape"
      }
    },
    "maybe_shape": {
      "anyOf": [
        {
          "$ref": "#/$defs/Shape"
        },
        {
          "type": "null"
        }
      ]
    },
    "message": {
      "$ref": "#/$defs/Message"
    },
    "version": {
      "$ref": "#/$defs/Version"
    },
    "event": {
      "$ref": "#/$defs/Event"
    },
    "pipeline": {
      "$ref": "#/$defs/Pipeline"
    },
    "duplicate": {
      "$ref": "#/$defs/Duplicate"
    },
    "mixed": {
      "$ref": "#/$defs/Mixed"
    },
    "declared": {
      "$ref": "#/$defs/Declared"
    }
  },
  "required": [
    "shape",
    "shapes"
  ],
  "$defs": {
    "Shape": {
      "description": "A shape.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "circle"
            },
            "radius": {
              "type": "number"
            }
          },
          "required": [
            "kind",
            "radius"
          ]
        },
        {
          "$ref": "#/$defs/Rect",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "rect"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/Polygon"
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "polygon"
                }
              },
              "required": [
                "kind"
              ]
            }
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "empty"
            }
          },
          "required": [
            "kind"
          ]
        }
      ]
    },
    "Rect": {
      "type": "object",
      "properties": {
        "w": {
          "type": "number"
        },
        "h": {
          "type": "number"
        }
      },
      "required": [
        "w",
        "h"
      ]
    },
    "Polygon": {
      "type": "object",
      "properties": {
        "sides": {
          "type": "integer"
        }
      },
      "required": [
        "sides"
      ]
    },
    "Message": {
      "description": "Adjacently tagged: the tag t and the content c.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "t": {
              "type": "string",
              "const": "text"
            },
            "c": {
              "type": "string"
            }
          },
          "required": [
            "t",
            "c"
          ]
        },
        {
          "type": "object",
          "properties": {
            "t": {
              "type": "string",
              "const": "point"
            },
            "c": {
              "type": "object",
              "properties": {
                "x": {
                  "type": "number"
                },
                "y": {
                  "type": "number"
                }
              },
              "required": [
                "x",
                "y"
              ]
            }
          },
          "required": [
            "t",
            "c"
          ]
        },
        {
          "type": "object",
          "properties": {
            "t": {
              "type": "string",
              "const": "ping"
            }
          },
          "required": [
            "t"
          ]
        }
      ]
    },
    "Version": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "version": {
              "type": "integer",
              "const": 1
            },
            "name": {
              "type": "string"
            }
          },
          "required": [
            "version",
            "name"
          ]
        },
        {
          "type": "object",
          "properties": {
            "version": {
              "type": "integer",
              "const": 2
            },
            "names": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "version",
            "names"
          ]
        }
      ]
    },
    "Event": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "started"
            },
            "at": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "at"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "stopped"
            },
            "code": {
              "type": "integer"
            }
          },
          "required": [
            "type",
            "code"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "Pipeline": {
      "description": "The tag may be left out: replication is the default.",
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "replication"
            },
            "source": {
              "type": "string"
            }
          },
          "required": [
            "source"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "transformation"
            },
            "models": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "models"
          ]
        }
      ]
    },
    "Duplicate": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "circle"
            },
            "radius": {
              "type": "number"
            }
          },
          "required": [
            "kind",
            "radius"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "circle"
            },
            "diameter": {
              "type": "number"
            }
          },
          "required": [
            "kind",
            "diameter"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "rect"
            },
            "w": {
              "type": "number"
            }
          },
          "required": [
            "kind",
            "w"
          ]
        }
      ]
    },
    "Mixed": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "circle"
            },
            "radius": {
              "type": "number"
            }
          },
          "required": [
            "kind",
            "radius"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "rect"
            },
            "w": {
              "type": "number"
            }
          },
          "required": [
            "kind",
            "w"
          ]
        }
      ]
    },
    "Declared": {
      "discriminator": {
        "propertyName": "shape"
      },
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "circle"
            },
            "shape": {
              "type": "string",
              "const": "round"
            },
            "radius": {
              "type": "number"
            }
          },
          "required": [
            "kind",
            "shape",
            "radius"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "rect"
            },
            "shape": {
              "type": "string",
              "const": "square"
            },
            "w": {
              "type": "number"
            }
          },
          "required": [
            "kind",
            "shape",
            "w"
          ]
        }
      ]
    }
  }
}
