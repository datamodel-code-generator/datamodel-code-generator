{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CondecimalCollision",
  "type": "object",
  "properties": {
    "amount": {
      "type": "number",
      "format": "decimal",
      "minimum": 0,
      "maximum": 100,
      "default": 12.34
    },
    "tax": {
      "type": "number",
      "format": "decimal",
      "minimum": 0,
      "maximum": 1,
      "default": 0.2
    },
    "Decimal": {
      "type": "string",
      "default": "shadow"
    },
    "Decimal_default": {
      "type": "string",
      "default": "shadow-default"
    }
  }
}
