{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pets",
  "type": "object",
  "properties": {
    "first": {
      "oneOf": [{"$ref": "#/$defs/Base"}, {"$ref": "#/$defs/Other"}],
      "discriminator": {"propertyName": "kind", "mapping": {"1": "#/$defs/Base", "5": "#/$defs/Other"}}
    },
    "second": {
      "oneOf": [{"$ref": "#/$defs/Child"}, {"$ref": "#/$defs/Other"}],
      "discriminator": {"propertyName": "kind", "mapping": {"2": "#/$defs/Child", "5": "#/$defs/Other"}}
    }
  },
  "$defs": {
    "Base": {
      "type": "object",
      "required": ["kind"],
      "properties": {"kind": {"type": "integer", "enum": [1, 2]}}
    },
    "Child": {
      "allOf": [{"$ref": "#/$defs/Base"}, {"type": "object", "properties": {"name": {"type": "string"}}}]
    },
    "Other": {
      "type": "object",
      "required": ["kind"],
      "properties": {"kind": {"type": "integer", "const": 5}}
    }
  }
}
