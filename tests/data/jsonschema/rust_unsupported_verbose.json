{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "Backreference": {
      "type": "string",
      "pattern": "(?x) ^ ([a-z]) \\1 $"
    },
    "ClassComment": {
      "type": "string",
      "pattern": "(?x) ^ [#a]+ $"
    },
    "CommentedSyntax": {
      "type": "string",
      "pattern": "(?x) ^ [a-z]+ $ # not \\1 and not (?>x)"
    },
    "EscapedHash": {
      "type": "string",
      "pattern": "(?x) ^ a \\# b $"
    },
    "ClassEscapedHash": {
      "type": "string",
      "pattern": "(?x) ^ [a\\#b]+ $"
    },
    "AcceptedVerbose": {
      "type": "string",
      "pattern": "(?x) ^ [a-z]+ $"
    },
    "MidPatternFlag": {
      "type": "string",
      "pattern": "^a(?x) b $"
    },
    "ScopedVerbose": {
      "type": "string",
      "pattern": "(?x: [a-z]+ )"
    }
  }
}
