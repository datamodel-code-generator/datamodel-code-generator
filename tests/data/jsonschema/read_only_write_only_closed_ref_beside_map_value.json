{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Item": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "readOnly": true
        },
        "name": {
          "type": "string"
        }
      }
    },
    "Closed": {
      "type": "object",
      "additionalProperties": false
    },
    "Holder": {
      "$ref": "#/$defs/Closed",
      "additionalProperties": {
        "$ref": "#/$defs/Item"
      }
    }
  },
  "type": "object",
  "properties": {
    "holder": {
      "$ref": "#/$defs/Holder"
    },
    "count": {
      "type": "integer",
      "writeOnly": true
    }
  }
}
