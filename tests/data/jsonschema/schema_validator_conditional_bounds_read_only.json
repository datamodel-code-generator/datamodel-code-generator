{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Order",
  "type": "object",
  "properties": {
    "id": {
      "type": "integer",
      "readOnly": true
    },
    "kind": {
      "type": "string"
    },
    "value": {
      "type": "integer"
    }
  },
  "if": {
    "properties": {
      "kind": {
        "const": "a"
      }
    },
    "required": [
      "kind"
    ]
  },
  "then": {
    "properties": {
      "value": {
        "minimum": 10
      },
      "id": {
        "maximum": 3
      }
    }
  }
}
