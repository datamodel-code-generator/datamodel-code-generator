{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "FieldMapping": {
      "type": "object",
      "properties": {
        "dateFieldFormat": {"type": "string", "minLength": 4, "maxLength": 40, "pattern": "^(?!\\s).*(?<!\\s)$"},
        "indexFieldName": {"type": "string", "minLength": 1, "maxLength": 30, "pattern": "^\\P{C}*$"},
        "description": {"type": "string", "pattern": "^[\\p{L}\\p{M}\\p{Z}\\p{S}\\p{N}\\p{P}]*$"},
        "tagKeys": {"type": "array", "items": {"$ref": "#/definitions/TagKey"}}
      }
    },
    "TagKey": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^([\\p{L}\\p{Z}\\p{N}_.:/=+\\-@]*)$"}
  }
}
