{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/a.json",
  "title": "A",
  "type": "object",
  "properties": {"b": {"$ref": "b.json"}},
  "$defs": {
    "Base": {"type": "object", "properties": {"owner": {"$ref": "#/$defs/Owner"}, "code": {"$ref": "code.json"}}},
    "Owner": {"type": "object", "properties": {"login": {"type": "string"}}},
    "Code": {"$id": "https://example.com/schemas/code.json", "type": "string", "enum": ["a", "b"]}
  }
}
