    "LinkOrNumber": {"anyOf": [{"$ref": "#/$defs/Link"}, {"type": "integer"}], "minLength": 12},
    "InlineLinkOrNumber": {"anyOf": [{"type": "string", "format": "uri"}, {"type": "integer"}], "minLength": 12}
  },
  "properties": {
    "link": {"$ref": "#/$defs/LinkOrNumber"},
    "inline": {"$ref": "#/$defs/InlineLinkOrNumber"}
  }
}
