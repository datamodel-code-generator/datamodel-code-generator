{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Holder",
  "type": "object",
  "properties": {
    "left": {"$ref": "#/definitions/Left"},
    "right": {"$ref": "#/definitions/Right"}
  },
  "definitions": {
    "Code": {"type": "string", "pattern": "^(?!bad)[a-z]+$"},
    "Base": {"type": "object", "properties": {"code": {"$ref": "#/definitions/Code"}}},
    "Left": {
      "allOf": [{"$ref": "#/definitions/Base"}, {"type": "object", "properties": {"x": {"type": "integer"}}}]
    },
    "Right": {
      "allOf": [{"$ref": "#/definitions/Base"}, {"type": "object", "properties": {"y": {"type": "integer"}}}]
    }
  }
}
