{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "pkg.Warn": {
      "type": "object",
      "properties": {"count": {"type": "integer"}, "x": {"$ref": "#/$defs/pkg.other.X"}}
    },
    "pkg.other.X": {"type": "object", "properties": {"warn": {"$ref": "#/$defs/pkg.Warn"}}},
    "pkg.Warn.Detail": {"type": "object", "properties": {"message": {"type": "string"}}},
    "pkg.api.Order": {"type": "object", "properties": {"detail": {"$ref": "#/$defs/pkg.Warn.Detail"}}}
  }
}
