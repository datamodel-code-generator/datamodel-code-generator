{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "Item": {
      "type": "object",
      "customTypePath": "builtins.dict",
      "properties": {
        "id": {"type": "string", "readOnly": true},
        "name": {"type": "string"}
      }
    },
    "Alias": {"$ref": "#/definitions/Item"},
    "Holder": {
      "type": "object",
      "properties": {
        "ref": {"$ref": "#/definitions/Item", "minProperties": 1},
        "alias": {"$ref": "#/definitions/Alias", "minProperties": 1},
        "list": {"type": "array", "items": {"$ref": "#/definitions/Item", "minProperties": 1}},
        "pair": {
          "type": "array",
          "items": [{"$ref": "#/definitions/Item", "minProperties": 1}, {"type": "string"}],
          "additionalItems": {"$ref": "#/definitions/Item", "minProperties": 1}
        },
        "union": {"anyOf": [{"$ref": "#/definitions/Item", "minProperties": 1}, {"type": "integer"}]},
        "choice": {"oneOf": [{"$ref": "#/definitions/Item", "minProperties": 1}, {"type": "boolean"}]},
        "count": {"type": "integer"}
      }
    },
    "Extras": {
      "type": "object",
      "additionalProperties": {"$ref": "#/definitions/Item", "minProperties": 1}
    }
  },
  "type": "object",
  "properties": {
    "holder": {"$ref": "#/definitions/Holder"},
    "extras": {"$ref": "#/definitions/Extras"},
    "item": {"$ref": "#/definitions/Item"}
  }
}
