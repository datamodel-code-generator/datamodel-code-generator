    },
    "q_desc": {
      "$ref": "#/$defs/Quantity",
      "description": "d"
    },
    "examples_max": {
      "$ref": "#/$defs/Q",
      "examples": [
        5
      ],
      "maximum": 9
    },
    "examples_only": {
      "$ref": "#/$defs/Q",
      "examples": [
        5
      ]
    },
    "titled": {
      "$ref": "#/$defs/Base",
      "minLength": 2
    }
  },
  "$defs": {
    "AB": {
      "type": "string",
      "enum": [
        "a",
        "b"
      ]
    },
    "Quantity": {
      "type": "integer",
      "minimum": 1
    },
    "Code": {
      "type": "string",
      "pattern": "^[A-Z]+$"
    },
    "Q": {
      "type": "integer",
      "minimum": 1,
      "examples": [
        1,
        2
      ]
    },
    "Base": {
      "type": "string",
      "title": "BaseT",
      "default": "base",
      "examples": [
        "bb"
      ]
    },
    "P1": {
      "type": "object",
      "properties": {
        "k": {
          "type": "string",
          "enum": [
            "a",
            "b"
          ]
        }
      }
    },
    "P2": {
      "type": "object",
      "properties": {
        "k": {
          "type": "string",
          "enum": [
            "b",
            "a"
          ],
          "description": "d"
        }
      }
    },
    "W3": {
      "allOf": [
        {
          "$ref": "#/$defs/P1"
        },
        {
          "$ref": "#/$defs/P2"
        }
      ]
    },
    "Pick": {
      "$ref": "#/$defs/AB",
      "enum": [
        "b"
      ]
    },
    "W1": {
      "$ref": "#/$defs/AB",
      "enum": [
        "a",
        "b"
      ]
    },
    "Sib": {
      "$ref": "#/$defs/Quantity",
      "maximum": 10
    },
    "Looser": {
      "$ref": "#/$defs/Quantity",
      "minimum": 0
    }
  }
