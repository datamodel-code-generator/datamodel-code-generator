{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Child",
  "$defs": {
    "Base": {
      "type": "object",
      "properties": {
        "settings": {
          "type": "object",
          "properties": {
            "default": {"type": "string"},
            "name": {"type": "string"},
            "nullable": {"type": "integer"},
            "examples": {"type": "integer"},
            "example": {"type": "boolean"}
          }
        },
        "tagged": {
          "type": "object",
          "patternProperties": {"default": {"type": "string"}, "^n": {"type": "integer"}}
        }
      }
    }
  },
  "allOf": [{"$ref": "#/$defs/Base"}],
  "type": "object",
  "properties": {
    "settings": {
      "type": "object",
      "properties": {"name": {"type": "string", "maxLength": 3}, "type": {"type": "string"}}
    },
    "tagged": {
      "type": "object",
      "patternProperties": {"^n": {"type": "integer", "minimum": 0}, "type": {"type": "string"}}
    }
  }
}
