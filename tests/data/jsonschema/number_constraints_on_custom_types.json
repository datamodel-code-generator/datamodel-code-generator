{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "NumberConstraintsOnCustomTypes",
  "type": "object",
  "properties": {
    "ratio": {
      "type": "string",
      "x-python-type": "fractions.Fraction",
      "maximum": 10
    },
    "scale": {
      "type": "string",
      "customTypePath": "fractions.Fraction",
      "minimum": 0
    },
    "amount": {
      "type": "string",
      "minimum": 0
    },
    "pause": {
      "type": "string",
      "format": "duration",
      "minimum": 0
    },
    "total": {
      "type": "integer",
      "minimum": 0
    }
  }
}
