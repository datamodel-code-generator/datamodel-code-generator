{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UnicodeWords",
  "type": "object",
  "properties": {
    "accented": {
      "type": "string",
      "enum": [
        "é"
      ],
      "pattern": "^\\w+$"
    },
    "word": {
      "type": "string",
      "pattern": "^\\w+$"
    }
  },
  "required": [
    "accented",
    "word"
  ]
}
