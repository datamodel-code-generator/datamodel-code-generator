{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ConstraintsOnTypingLookalikes",
  "type": "object",
  "properties": {
    "annotated": {
      "type": "integer",
      "x-python-type": "mypkg.Annotated[int, str]",
      "pattern": "^a"
    },
    "final": {
      "type": "integer",
      "x-python-type": "mypkg.Final[int]",
      "pattern": "^a"
    },
    "union": {
      "x-python-type": "mypkg.Union[int, str]",
      "pattern": "^a"
    },
    "optional": {
      "x-python-type": "mypkg.Optional[int]",
      "minLength": 2
    }
  }
}
