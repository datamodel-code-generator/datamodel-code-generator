{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Session",
  "type": "object",
  "properties": {
    "token": {
      "$ref": "#/$defs/AdminToken"
    }
  },
  "$defs": {
    "AdminToken": {
      "allOf": [
        {
          "$ref": "#/$defs/Token"
        },
        {
          "type": "object",
          "properties": {
            "scopes": {
              "type": "array",
              "description": "The scopes an admin token grants."
            }
          }
        }
      ]
    },
    "Token": {
      "type": "object",
      "properties": {
        "scopes": {
          "const": [
            "read",
            "write"
          ]
        }
      }
    }
  }
}
