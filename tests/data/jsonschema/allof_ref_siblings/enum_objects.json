{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Root",
  "$defs": {
    "Base": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "a": {
            "type": "integer"
          },
          "b": {
            "type": "integer"
          }
        },
        "required": [
          "a",
          "b"
        ]
      }
    }
  },
  "allOf": [
    {
      "$ref": "#/$defs/Base",
      "enum": [
        [],
        [
          {
            "a": 1,
            "b": 2
          }
        ]
      ]
    }
  ]
}
