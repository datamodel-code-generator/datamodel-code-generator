{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "Doubled": {
      "description": "Backreference only Python's regex engine supports.",
      "type": "string",
      "pattern": "^(a)\\1$"
    },
    "Lookahead": {
      "type": "string",
      "pattern": "^(?=.*[A-Z]).+$"
    },
    "Plain": {
      "type": "string",
      "pattern": "^[a-z]+$"
    },
    "PlainHolder": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z]+$"
        }
      }
    },
    "LookaheadHolder": {
      "type": "object",
      "properties": {
        "code": {
          "$ref": "#/definitions/Lookahead"
        }
      }
    },
    "KeyHolder": {
      "type": "object",
      "propertyNames": {
        "pattern": "^(k)\\1$"
      },
      "additionalProperties": {
        "type": "integer"
      }
    }
  },
  "type": "object",
  "properties": {
    "pair": {
      "type": "string",
      "pattern": "^(?P<letter>[a-z])(?P=letter)$"
    },
    "doubled": {
      "$ref": "#/definitions/Doubled"
    },
    "plain": {
      "$ref": "#/definitions/Plain"
    },
    "holder": {
      "$ref": "#/definitions/PlainHolder"
    }
  }
}
