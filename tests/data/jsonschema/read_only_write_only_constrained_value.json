{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "Item": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "readOnly": true
        },
        "name": {
          "type": "string"
        }
      }
    },
    "Items": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/Item"
      }
    },
    "Alias": {
      "$ref": "#/definitions/Item"
    },
    "Holder": {
      "type": "object",
      "properties": {
        "map": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/Item",
            "minLength": 1
          }
        },
        "alias": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/Alias",
            "minLength": 1
          }
        },
        "count": {
          "type": "integer"
        },
        "free": true
      },
      "additionalProperties": {
        "$ref": "#/definitions/Item",
        "minLength": 1
      }
    },
    "Unions": {
      "type": "object",
      "properties": {
        "choice": {
          "minLength": 1,
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "readOnly": true
                },
                "name": {
                  "type": "string"
                }
              }
            },
            {
              "type": "integer"
            }
          ]
        },
        "union": {
          "minLength": 1,
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "readOnly": true
                },
                "name": {
                  "type": "string"
                }
              }
            },
            {
              "type": "boolean"
            }
          ]
        }
      }
    },
    "Wrapping": {
      "type": "object",
      "properties": {
        "rows": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/Items",
            "minItems": 1
          }
        },
        "members": {
          "minItems": 1,
          "anyOf": [
            {
              "$ref": "#/definitions/Items"
            },
            {
              "type": "integer"
            }
          ]
        },
        "inline": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "readOnly": true
              },
              "name": {
                "type": "string"
              }
            },
            "minProperties": 1
          }
        }
      }
    }
  },
  "type": "object",
  "properties": {
    "holder": {
      "$ref": "#/definitions/Holder"
    },
    "unions": {
      "$ref": "#/definitions/Unions"
    },
    "wrapping": {
      "$ref": "#/definitions/Wrapping"
    },
    "item": {
      "$ref": "#/definitions/Item"
    }
  }
}
